{"type":"before","callId":"pxoa@61","startTime":58016.99,"class":"Page","method":"addInitScript","params":{"source":"(() => {\n    const capture = {\n      picked: 0,\n      directories: [],\n      files: {}\n    };\n    Object.assign(window, {\n      __testDirectory: capture\n    });\n    function directory(name, prefix = name) {\n      const children = new Map();\n      return {\n        name,\n        async getDirectoryHandle(child, options) {\n          if (children.has(child)) return children.get(child);\n          if (!(options !== null && options !== void 0 && options.create)) throw new DOMException('Controlled missing directory', 'NotFoundError');\n          const next = directory(child, `${prefix}/${child}`);\n          children.set(child, next);\n          capture.directories.push(`${prefix}/${child}`);\n          return next;\n        },\n        async getFileHandle(filename) {\n          return {\n            async createWritable() {\n              let pending = [];\n              return {\n                async write(bytes) {\n                  pending = Array.from(bytes);\n                },\n                async close() {\n                  capture.files[`${prefix}/${filename}`] = pending;\n                },\n                async abort() {\n                  pending = [];\n                }\n              };\n            }\n          };\n        }\n      };\n    }\n    Object.defineProperty(window, 'showDirectoryPicker', {\n      configurable: true,\n      value: async () => {\n        capture.picked++;\n        return directory('测试下载目录');\n      }\n    });\n  })(undefined)"}}
