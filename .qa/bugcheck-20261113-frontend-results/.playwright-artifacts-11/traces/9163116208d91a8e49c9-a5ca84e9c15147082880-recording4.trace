: 20px; font-weight: 700; line-height: 1.2; }\n.scene-management .scene-sync-counts span { color: var(--muted); font-size: 12px; }\n.scene-management .scene-sync-counts .is-warn strong { color: #b42318; }\n.scene-management .scene-sync-missing, .scene-management .scene-sync-more { min-width: 0; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: #fcfdff; font-size: 13px; }\n.scene-management .scene-sync-missing summary, .scene-management .scene-sync-more summary { color: #334155; font-weight: 600; cursor: pointer; }\n.scene-management .scene-sync-missing p { margin: 8px 0; color: var(--muted); line-height: 1.7; }\n.scene-management .scene-sync-missing textarea { box-sizing: border-box; width: 100%; min-height: 6em; padding: 6px 8px; border: 1px solid #d7e0ee; border-radius: 8px; overflow-x: auto; overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }\n.scene-management .scene-sync-more ul { margin: 10px 0 0; padding-left: 18px; color: var(--muted); line-height: 1.8; }\n.scene-management .scene-sync-repair { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 8px; }\n.scene-management .scene-sync-repair [role=status] { display: inline-flex; align-items: center; gap: 6px; color: var(--primary); font-size: 13px; }\n.scene-management .scene-sync-repair-result p { margin: 0; font-size: 13px; line-height: 1.7; }\n.scene-management .scene-sync-repair-result .is-ok { color: #2f7d4a; }\n.scene-management .scene-sync-repair-result .is-warn { color: #9a6700; }\n.scene-management .scene-sync-repair-result ul { margin: 6px 0 0; padding-left: 18px; color: var(--muted); font-size: 12px; line-height: 1.8; }\n.scene-management .scene-sync-repair-result code { margin-right: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; overflow-wrap: anywhere; }\n.scene-management .scene-sync-limit { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; color: #334155; }\n.scene-management .scene-sync-limit input { width: 90px; height: 32px; padding: 0 8px; border: 1px solid #d7e0ee; border-radius: 8px; font: inherit; }\n.scene-management .scene-sync-confirm { padding: 16px; font-size: 14px; line-height: 1.8; }\n.scene-management .scene-sync-confirm p { margin: 0; }\n@media (max-width: 760px) {\n  .scene-management .scene-sync-counts { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@container scene-details (max-width: 719px) {\n  .scene-detail-header, .scene-detail-actions { width: 100%; }\n}\n@container scene-details (max-width: 479px) {\n  .scene-detail-actions, .scene-detail-primary-actions { display: flex; flex-direction: column; align-items: stretch; width: 100%; }\n  .scene-detail-danger-actions { width: 100%; }\n  .scene-summary > div { grid-template-columns: 1fr; }\n  .scene-sync-controls { flex-direction: column; align-items: stretch; }\n}\n.scene-management .scene-details[data-scene-width=medium] .scene-detail-header,\n.scene-management .scene-details[data-scene-width=medium] .scene-detail-actions { width: 100%; }\n.scene-management .scene-details[data-scene-width=compact] .scene-detail-actions,\n.scene-management .scene-details[data-scene-width=compact] .scene-detail-primary-actions { display: flex; flex-direction: column; align-items: stretch; width: 100%; }\n.scene-management .scene-details[data-scene-width=compact] .scene-detail-danger-actions { width: 100%; }\n.scene-management .scene-details[data-scene-width=compact] .scene-summary > div { grid-template-columns: 1fr; }\n.scene-management .scene-details[data-scene-width=compact] .scene-sync-controls { flex-direction: column; align-items: stretch; }"],["STYLE",{},":root {\r\n  font-family: system-ui, Avenir, Helvetica, Arial, sans-serif;\r\n  font-size: 15px;\r\n  line-height: 1.5;\r\n  font-weight: 400;\r\n  font-synthesis: none;\r\n  color-scheme: light;\r\n  color: #161a1d;\r\n  background: #f6f7f8;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  --app-topbar-h: 56px;\r\n  --sidebar-width: 200px;\r\n  --primary: #2c56a0;\r\n  --primary-hover: #1e478e;\r\n  --primary-soft: #eaf2ff;\r\n  --text: #161a1d;\r\n  --muted: #6b7280;\r\n  --border: rgba(22,26,29,.08);\r\n  --surface: rgba(255,255,255,.82);\r\n  --panel-bg: rgba(255,255,255,.82);\r\n  --canvas: #f6f7f8;\r\n  --sidebar-bg: rgba(246,247,248,.88);\r\n  --hover: rgba(22,26,29,.045);\r\n  --active: rgba(44,86,160,.12);\r\n  --focus: rgba(44,86,160,.38);\r\n}\r\n* { box-sizing: border-box; }\r\n[hidden] { display: none !important; }\r\nhtml, body, #root { width: 100%; height: 100%; margin: 0; overflow: hidden; }\r\nbody { margin: 0; min-width: 360px; }\r\nbutton, input, select, textarea { font: inherit; }\r\nbutton, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }\r\nbutton { font: inherit; cursor: pointer; color: inherit; border: none; background: transparent; padding: 0; box-sizing: border-box; transition: background .12s, border-color .12s, color .12s; }\r\nbutton:disabled { cursor: not-allowed; opacity: .6; }\r\nbutton:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid #85a8e2; outline-offset: 2px; }\r\nbutton svg, a svg { flex-shrink: 0; }\r\na { color: inherit; text-decoration: none; }\r\na:hover { color: var(--primary); }\r\nimg { display: block; max-width: 100%; }\r\nh1, h2, h3, h4, p { margin: 0; }\r\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\r\n.file-picker { position: relative; cursor: pointer; }\r\n.file-picker-input { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; padding: 0; margin: 0; opacity: 0; cursor: pointer; }\r\n.file-picker:focus-within { outline: 2px solid #85a8e2; outline-offset: 2px; }\r\n.file-picker.is-disabled { cursor: not-allowed; opacity: .6; }\r\n.file-picker-input:disabled { cursor: not-allowed; }\r\n.app-shell { display: flex; height: 100dvh; min-height: 0; overflow: hidden; background: var(--canvas); }\r\n.sidebar { position: fixed; inset: 0 auto 0 0; width: var(--sidebar-width); height: 100%; display: flex; flex-direction: column; background: var(--sidebar-bg); border-right: 1px solid var(--border); z-index: 30; backdrop-filter: blur(10px); transition: width .2s ease; }\r\n.sidebar-heading { height: var(--app-topbar-h); min-height: var(--app-topbar-h); display: flex; align-items: center; justify-content: space-between; padding: 0 10px; border-bottom: 1px solid var(--border); font-size: 16px; font-weight: 800; color: #374151; letter-spacing: .2px; }\r\n.sidebar-heading svg { color: #8490a1; }\r\n.brand { display: flex; align-items: center; gap: 10px; padding: 20px 15px 18px; }\r\n.brand-symbol { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid #e0e7f0; border-radius: 6px; background: #f0f4fa; color: #657d9f; }\r\n.brand b { font-size: 15px; font-weight: 600; display: block; }\r\n.brand small { color: #6b7280; display: block; font-size: 12px; margin-top: 5px; letter-spacing: .3px; }\r\n.sidebar nav { padding: 5px; min-height: 0; overflow: auto; }\r\n.nav-group-label { display: block; font-size: 14px; font-weight: 600; color: #6b7280; margin: 8px 8px 4px; }\r\n.nav-group-second { margin-top: 18px; }\r\n.nav-item { width: 100%; display: flex; align-items: center; gap: 10px; padding: 5px 6px; min-height: 38px; margin: 3px 0; border-radius: 6px; background: transparent; color: #2a2f36; text-align: left; font-size: 15px; }\r\n.nav-item:hover { background: var(--hover); }\r\n.nav-item.active { background: var(--active); color: var(--primary); font-weight: 500; }\r\n.nav-item small { font-size: 12px; color: #94a3b8; margin-left: auto; font-weight: 400; }\r\n.sidebar-bottom { margin-top: auto; padding-top: 24px; }\r\n.sidebar-connection { display: flex; align-items: center; gap: 6px; width: 100%; padding: 12px 10px; background: transparent; color: #6b7280; font-size: 12px; }\r\n.sidebar-connection svg { margin-left: auto; }\r\n.status-dot { display: inline-block; flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: #a5afbd; }\r\n.status-dot.online { background: #599987; }\r\n.status-dot.offline { background: #c5a16b; }\r\n.status-dot.checking { animation: pulse 1.4s infinite; }\r\n.sidebar-footer { display: flex; align-items: center; gap: 9px; padding: 17px 13px; border-top: 1px solid var(--border); font-size: 13px; }\r\n.sidebar-footer small { display: block; margin-top: 5px; font-size: 12px; color: #6b7280; }\r\n.avatar { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid #dae3f2; border-radius: 50%; color: #7791b6; background: #eef3fa; }\r\n.main-shell { margin-left: var(--sidebar-width); flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; transition: margin-left .2s ease; }\r\n.topbar { display: flex; flex-shrink: 0; justify-content: space-between; align-items: center; height: var(--app-topbar-h); padding: 0 16px; gap: 14px; background: var(--surface); border-bottom: 1px solid var(--border); backdrop-filter: blur(10px); }\r\n.topbar-left { display: flex; align-items: center; gap: 8px; min-width: 0; }\r\n.topbar-title h1 { font-size: 18px; font-weight: 700; letter-spacing: .2px; color: #161a1d; }\r\n.topbar-title>span { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }\r\n.topbar-actions { display: flex; gap: 11px; align-items: center; }\r\n.icon-button { display: inline-flex; align-items: center; justify-content: center; width: 29px; height: 29px; padding: 0; background: transparent; color: #6b7280; border-radius: 4px; }\r\n.icon-button:hover:not(:disabled) { color: var(--primary); background: #eff4fb; }\r\n.mobile-menu, .sidebar-scrim { display: none; }\r\nmain { flex: 1; min-height: 0; width: 100%; max-width: none; padding: 14px; margin: 0; overflow: auto; }\r\n.search-workspace { display: grid; flex: 1; min-height: 0; grid-template-columns: 330px minmax(0,1fr); grid-template-rows: minmax(0,1fr); gap: 12px; }\r\n.panel { width: 100%; background: #fff; border: 1px solid rgba(148,163,184,.25); border-radius: 12px; overflow: hidden; min-width: 0; }\r\n.panel-heading { display: flex; flex-shrink: 0; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; padding: 14px 16px; border-bottom: 1px solid var(--border); min-height: 50px; }\r\n.panel-heading>div { display: flex; align-items: center; gap: 8px; }\r\n.panel-heading h2 { font-size: 14px; font-weight: 700; color: #334155; }\r\n.subtle-label { color: #94a3b8; font-size: 12px; }\r\n.query-body { display: flex; flex-direction: column; align-items: stretch; gap: 12px; padding: 12px; }\r\n.query-source { display: grid; gap: 10px; min-width: 0; }\r\n.segmented { display: flex; width: 100%; padding: 3px; border: 1px solid #e1e6ee; background: #f7f8fa; border-radius: 8px; }\r\n.segmented button { display: flex; flex: 1; align-items: center; justify-content: center; gap: 6px; padding: 7px 5px; min-height: 34px; font-size: 14px; white-space: nowrap; color: #6b7280; background: transparent; border-radius: 5px; }\r\n.segmented button.selected { color: var(--primary); background: #fff; box-shadow: 0 0 0 1px #e1e7f1; }\r\n.upload-area { display: flex; align-items: center; position: relative; min-width: 0; min-height: 80px; border: 1px dashed #ccd5e3; border-radius: 8px; background: #fcfdff; overflow: hidden; }\r\n.upload-area.is-dragging { background: #edf4ff; border-color: #7c9fd3; }\r\n.upload-trigger { display: flex; width: 100%; align-items: center; gap: 12px; min-height: 78px; padding: 10px 12px; background: transparent; text-align: left; }\r\n.upload-icon { display: grid; place-items: center; color: #8fa2bf; width: 38px; height: 38px; border: 1px solid #e0e7f0; border-radius: 8px; background: #f2f5f9; flex-shrink: 0; }\r\n.upload-copy { display: flex; flex: 1; flex-direction: column; gap: 4px; min-width: 0; }\r\n.upload-copy b { font-size: 14px; color: #475569; font-weight: 500; }\r\n.upload-copy small { font-size: 12px; color: #7b8899; line-height: 1.8; }\r\n.upload-trigger:hover { background: #f2f6fc; }\r\n.upload-area.has-image { flex-direction: column; align-items: stretch; padding: 6px; gap: 8px; }\r\n.query-preview { width: 100%; height: 220px; object-fit: contain; border: 1px solid #e4e9ef; border-radius: 5px; background: #f2f4f7; flex-shrink: 0; }\r\n.query-preview-frame { position: relative; min-width: 0; }\r\n.query-preview-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 7px; color: #7b8899; background: #f2f4f7; font-size: 12px; }\r\n.query-preview-unavailable { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: #7b8899; font-size: 13px; }\r\n.query-preview-unavailable small { font-size: 12px; }\r\n.selected-file-info { min-width: 0; display: flex; flex-direction: column; gap: 4px; padding: 2px 5px 5px; }\r\n.selected-file-info b { font-size: 13px; font-weight: 500; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }\r\n.selected-file-info>span { font-size: 12px; color: #6b7280; }\r\n.replace-image { display: inline-flex; gap: 5px; align-items: center; align-self: flex-start; padding: 0; background: transparent; color: #5e80b2; font-size: 12px; }\r\n.remove-image { display: grid; place-items: center; position: absolute; top: 8px; right: 8px; width: 29px; height: 29px; background: #fffffff0; color: #718198; border: 1px solid #e1e7f0; border-radius: 6px; }\r\n.query-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 0; }\r\n.query-actions .search-button { flex: 1; }\r\n.query-actions .cancel-search { order: 1; flex-basis: 100%; text-align: center; }\r\n.btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid transparent; border-radius: 10px; min-height: 38px; padding: 8px 14px; font-size: 14px; font-weight: 600; letter-spacing: .01em; line-height: 1.4; white-space: nowrap; user-select: none; }\r\n.btn-primary { background: #eaf2ff; border-color: #cfe0ff; color: #1d4ed8; }\r\n.btn-primary:hover:not(:disabled) { background: #deebff; border-color: #b7d1ff; color: #1d4ed8; }\r\n.btn-secondary { background: #f2f6ff; border-color: #d7e2ff; color: #334155; }\r\n.btn-secondary:hover:not(:disabled) { background: #e9efff; border-color: #c2d2ff; }\r\n.text-button { background: transparent; color: #2c56a0; font-size: 13px; padding: 5px 0; }\r\n.input { width: 100%; border: 1px solid rgba(148,163,184,.45); border-radius: 10px; padding: 8px 12px; font-size: 14px; font-weight: 600; color: #223046; background: #f8fafc; outline: none; }\r\n.input:focus { background: #fff; border-color: rgba(59,130,246,.65); box-shadow: 0 0 0 3px rgba(59,130,246,.12); }\r\n.input::placeholder { color: #a6b0c0; font-size: 13px; }\r\n.url-input-area { display: flex; flex-direction: column; min-width: 0; gap: 8px; }\r\n.url-input-area p { font-size: 12px; color: #99a5b7; }\r\n.cancel-search { padding: 0; }\r\n.count-badge { display: inline-block; padding: 1px 6px; border-radius: 3px; background: #eef3fa; color: #7790b2; font-size: 12px; font-weight: 400; }\r\n.result-toolbar { display: flex; flex-shrink: 0; align-items: center; gap: 12px; min-width: 0; padding: 5px 10px; border-bottom: 1px solid var(--border); background: rgba(255,255,255,.82); }\r\n.results-heading { display: flex; flex-shrink: 0; align-items: center; gap: 7px; white-space: nowrap; }\r\n.results-heading h2 { font-size: 14px; line-height: 20px; font-weight: 700; color: #334155; }\r\n.result-timing { color: #8491a3; font-size: 12px; font-variant-numeric: tabular-nums; }\r\n.result-filters { display: flex; flex: 1; align-items: center; gap: 7px; min-width: 0; padding: 2px; margin: -2px; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #d5dde8 transparent; }\r\n.filter-input { display: flex; flex: 1 0 155px; align-items: center; gap: 6px; min-width: 155px; width: auto; height: 30px; padding: 0 8px; border: 1px solid rgba(148,163,184,.45); background: #f8fafc; border-radius: 6px; color: #6b7b90; }\r\n.filter-input>svg { flex-shrink: 0; }\r\n.filter-input input { border: 0; outline: none; padding: 0; width: 100%; min-width: 0; background: transparent; font-size: 14px; font-weight: 500; color: #223046; }\r\n.filter-input input::placeholder { color: #94a3b8; }\r\n.toolbar-select { display: flex; flex-shrink: 0; align-items: center; gap: 4px; color: #8fa0b7; }\r\n.toolbar-select select { border: 1px solid rgba(148,163,184,.45); border-radius: 6px; padding: 0 6px; background: #f8fafc; font-size: 13px; color: #334155; height: 30px; max-width: 128px; }\r\n.toolbar-select select:disabled { color: #a5afbd; }\r\n.view-toggle { display: flex; flex-shrink: 0; margin-left: auto; padding: 1px; gap: 1px; border: 1px solid #dfe6ef; background: #fff; border-radius: 5px; }\r\n.view-toggle button { display: grid; place-items: center; min-height: 26px; padding: 3px 6px; border-radius: 4px; background: transparent; color: #78899f; }\r\n.view-toggle button.selected { color: var(--primary); background: #edf3fc; }\r\n.results-empty, .no-results { min-height: 330px; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 35px 20px; text-align: center; }\r\n.empty-image-icon { display: grid; place-items: center; width: 62px; height: 62px; border-radius: 9px; background: #f5f7fa; border: 1px solid #e9edf3; color: #acb9cb; margin-bottom: 20px; }\r\n.results-empty h3, .no-results h3 { font-size: 16px; font-weight: 500; color: #64748b; }\r\n.results-empty p, .no-results p { font-size: 13px; color: #94a3b8; margin-top: 11px; line-height: 1.9; }\r\n.empty-steps { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; font-size: 12px; color: #7b8899; margin-top: 28px; }\r\n.empty-steps svg { color: #c0c9d6; }\r\n.no-results { gap: 13px; color: #a4b4cb; }\r\n.no-results p { margin: 0; }\r\n.no-results .btn { margin-top: 5px; }\r\n.result-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,270px),1fr)); gap: 14px; padding: 14px; }\r\n.result-card { border: 1px solid #e0e6ef; border-radius: 5px; overflow: hidden; background: #fff; transition: border-color .15s; min-width: 0; }\r\n.result-card:hover { border-color: #b2c5df; }\r\n.result-image-button { display: block; position: relative; aspect-ratio: 4 / 3; width: 100%; padding: 0; overflow: hidden; background: #f3f5f8; }\r\n.result-image-button>img { width: 100%; height: 100%; object-fit: cover; }\r\n.score { display: inline-flex; gap: 4px; align-items: center; border: 1px solid #dbe6f6; padding: 3px 6px; border-radius: 3px; background: #f2f6fd; color: #6285b7; font-size: 12px; font-weight: 400; white-space: nowrap; font-variant-numeric: tabular-nums; }\r\n.score-unknown { background: #f7f8fa; border-color: #e2e7ef; color: #94a3b8; }\r\n.result-image-button .score { position: absolute; top: 8px; left: 8px; background: #fffffff2; }\r\n.image-hover-hint { position: absolute; inset: auto 0 0; display: flex; justify-content: center; align-items: center; gap: 6px; padding: 8px; background: #30435fce; color: #fff; font-size: 13px; transform: translateY(100%); transition: transform .15s; }\r\n.result-image-button:hover .image-hover-hint, .result-image-button:focus-visible .image-hover-hint { transform: translateY(0); }\r\n.result-card-body { padding: 10px 10px 7px; }\r\n.result-card h3 { line-height: 1.7; font-size: 14px; font-weight: 500; overflow: hidden; }\r\n.result-card h3 button { display: block; width: 100%; padding: 0; text-align: left; background: transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n.result-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px; font-size: 12px; color: #6b7280; }\r\n.result-card-meta>span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\r\n.download-button { width: 31px; height: 31px; border: 1px solid #dce5f1; color: #6d8cb7; }\r\n.image-unavailable { height: 100%; min-height: 60px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; font-size: 13px; background: #f4f6f9; color: #a1aec2; }\r\n.results-footer { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px; border-top: 1px solid var(--border); background: rgba(255,255,255,.92); color: #374151; font-size: 14px; min-height: 44px; }\r\n.results-footer small { font-size: 12px; }\r\n.pagination { display: flex; align-items: center; gap: 9px; font-variant-numeric: tabular-nums; }\r\n.pagination>.icon-button { border: 1px solid #e0e6f0; width: 27px; height: 27px; }\r\n.pagination>span { background: #f2f5fa; border: 1px solid #e0e6ef; border-radius: 4px; color: #6382ad; min-width: 42px; text-align: center; padding: 5px 6px; font-size: 12px; }\r\n.pagination small { color: #9aaac0; }\r\n.search-bottom-note { display: flex; align-items: center; gap: 15px; flex-wrap: wrap; font-size: 12px; color: #94a3b8; margin-top: 7px; }\r\n.local-filter-note { margin-left: auto; }\r\n.trace-id { font-family: ui-monospace,monospace; max-width: 330px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n.result-table-scroll { width: 100%; overflow-x: auto; }\r\n.result-table { width: 100%; border-collapse: collapse; min-width: 750px; text-align: left; font-size: 14px; }\r\n.result-table th { font-weight: 500; }\r\n.result-table thead { background: #f8fafc; color: #223046; font-size: 14px; }\r\n.result-table th, .result-table td { padding: 10px 15px; border-bottom: 1px solid #e8ecf3; }\r\n.result-table tbody tr:last-child>* { border-bottom: 0; }\r\n.result-table tbody tr:hover { background: #fafbfe; }\r\n.result-table tbody td { color: #374151; font-size: 14px; }\r\n.result-table th:nth-child(2) { width: 32%; }\r\n.table-image { display: block; width: 96px; height: 72px; padding: 0; border: 1px solid #e1e7f0; border-radius: 3px; overflow: hidden; background: #f3f5f9; }\r\n.table-image img { width: 100%; height: 100%; object-fit: cover; }\r\n.table-image .image-unavailable { min-height: 0; height: 100%; }\r\n.table-image .image-unavailable span { display: none; }\r\n.table-image .image-unavailable svg { width: 22px; }\r\n.table-title { padding: 0; background: transparent; text-align: left; line-height: 1.8; color: #223046; font-size: 14px; }\r\n.table-title:hover { color: var(--primary); }\r\n.table-actions { display: flex; gap: 7px; }\r\n.table-actions .btn { min-height: 34px; padding: 6px 10px; font-size: 14px; }\r\n.loading-state { min-height: 330px; padding: 45px 20px; text-align: center; }\r\n.loading-orbit { display: grid; place-items: center; width: 62px; height: 62px; margin: 0 auto 22px; background: #f3f6fb; border: 1px solid #e1e8f3; border-radius: 8px; color: #90a6c6; animation: pulse 1.6s infinite; }\r\n.loading-state h3 { font-size: 16px; font-weight: 500; color: #64748b; }\r\n.loading-state p { color: #94a3b8; font-size: 13px; margin-top: 11px; }\r\n.skeleton-row { display: flex; gap: 13px; max-width: 400px; margin: 26px auto 0; }\r\n.skeleton-card { flex: 1; height: 46px; border-radius: 4px; background: linear-gradient(110deg,#f2f5f9 30%,#fafcfe 50%,#f2f5f9 70%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }\r\n.spin { animation: spin 1.1s linear infinite; }\r\n.dialog { padding: 0; border: 1px solid #0d0d0d; border-radius: 6px; width: min(500px,calc(100vw - 30px)); max-height: 95dvh; overflow: hidden; color: #1f2f4d; background: #f9f9f9; box-shadow: 0 16px 44px rgba(15,23,42,.16),0 6px 14px rgba(15,23,42,.1); }\r\n.dialog::backdrop { background: rgba(15,23,42,.38); backdrop-filter: blur(2px); }\r\n.dialog-wide { width: min(700px,calc(100vw - 30px)); }\r\n.dialog-heading { position: relative; flex-shrink: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 6px 10px 6px 12px; min-height: 40px; background: #f7f9fc; border-bottom: 1px solid #e6ebf3; }\r\n.dialog-heading h2 { font-size: 20px; font-weight: 900; letter-spacing: .2px; color: #0f172a; }\r\n.dialog-heading .icon-button { width: 25px; height: 25px; }\r\n.dialog[open] { display: flex; flex-direction: column; }\r\n.dialog-body { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; }\r\n.dialog-footer { flex-shrink: 0; }\r\n.dialog-body:has(>.mg-editor) { display: flex; overflow: hidden; }\r\n.dialog-body>.mg-editor { flex: 1; min-height: 0; }\r\n.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 22px; }\r\n.settings-content, .help-content { padding: 20px; background: #fff; }\r\n.settings-content>p { color: #64748b; font-size: 14px; line-height: 1.8; margin-bottom: 20px; }\r\n.settings-content>label { display: block; margin-bottom: 9px; font-size: 14px; }\r\n.settings-content>small { display: block; margin-top: 10px; font-size: 12px; color: #94a3b8; line-height: 1.9; }\r\n.connection-info { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 18px; color: #6b7280; font-size: 12px; }\r\n.connection-info button { margin-left: auto; }\r\n.help-content>div { display: flex; align-items: flex-start; gap: 13px; margin-bottom: 23px; color: #819ac0; }\r\n.help-content h3 { font-size: 14px; font-weight: 500; color: #334155; margin-bottom: 8px; }\r\n.help-content p { font-size: 13px; line-height: 1.9; color: #64748b; }\r\n.help-note { background: #f5f8fc; border: 1px solid #e5ebf5; border-radius: 5px; padding: 11px; font-size: 12px; line-height: 1.8; margin-bottom: 0!important; }\r\n.detail-content { padding: 5px; background: #f6f8fb; }\r\n.detail-section { padding: 6px 16px 9px; border: 1px solid #edf1f7; border-radius: 10px; background: #fcfdff; margin-bottom: 5px; }\r\n.detail-section:last-child { margin-bottom: 0; }\r\n.detail-section>h3 { font-size: 14px; font-weight: 800; color: #1f2f4d; margin-bottom: 12px; }\r\n.detail-summary { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 0 0 14px; }\r\n.detail-summary h4 { font-size: 15px; line-height: 1.8; font-weight: 500; overflow-wrap: anywhere; }\r\n.detail-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1px 18px; margin: 0; padding: 0; }\r\n.detail-fields>div { display: grid; grid-template-columns: 65px minmax(0,1fr); align-items: start; gap: 10px; font-size: 14px; line-height: 1.5; padding: 4px 8px; border-radius: 8px; }\r\n.detail-fields dt, .detail-links dt { color: #7b8899; font-size: 13px; }\r\n.detail-fields dd { margin: 0; color: #223046; font-weight: 600; overflow-wrap: anywhere; padding: 1px 6px; }\r\n.monospace { font-family: ui-monospace,SFMono-Regular,Consolas,monospace; font-size: 13px; }\r\n/* The original is loaded here (lists show thumbnails only), so give it room to be seen */\r\n.detail-image { display: flex; align-items: center; justify-content: center; height: min(56vh, 460px); min-height: 200px; padding: 10px; border: 1px solid #e8edf5; border-radius: 5px; background: #f5f7fa; }\r\n.detail-image>.progressive-image { flex: 1; align-self: stretch; }\r\n.detail-image .image-unavailable { width: 100%; min-height: 150px; }\r\n.detail-links { display: flex; flex-direction: column; gap: 15px; margin: 0; }\r\n.detail-links>div { display: grid; grid-template-columns: 75px minmax(0,1fr); gap: 9px; align-items: start; line-height: 1.7; font-size: 13px; }\r\n.detail-links dd { margin: 0; min-width: 0; color: #475569; }\r\n.detail-links a { display: inline-flex; gap: 3px; align-items: center; max-width: 100%; overflow-wrap: anywhere; word-break: break-all; }\r\n.detail-links a:hover { text-decoration: underline; }\r\n.detail-description { display: grid; grid-template-columns: 75px minmax(0,1fr); gap: 9px; margin-top: 15px; color: #7a8aa4; font-size: 13px; line-height: 1.8; }\r\n.detail-description>div { padding: 8px 11px; border: 1px solid #e6ecf5; border-radius: 5px; background: #f8faff; color: #334155; max-height: 140px; overflow: auto; overflow-wrap: anywhere; }\r\n.detail-description p+p { margin-top: 6px; }\r\n.detail-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; background: rgba(252,253,255,.92); border-top: 1px solid rgba(148,163,184,.22); box-shadow: 0 -6px 18px rgba(15,23,42,.04); backdrop-filter: blur(8px); }\r\n.detail-footer>p { font-size: 12px; color: #94a3b8; line-height: 1.8; max-width: 235px; }\r\n.detail-actions { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }\r\n.detail-actions .btn { min-height: 34px; height: auto; padding: 7px 12px; font-size: 14px; border-radius: 8px; }\r\n.inline-error { color: #b37d73!important; font-size: 13px!important; line-height: 1.8!important; padding: 7px; }\r\n@keyframes spin { to { transform: rotate(360deg); } }\r\n@keyframes pulse { 50% { opacity: .5; } }\r\n@keyframes shimmer { to { background-position: -200% 0; } }\r\n.search-page { display: flex; flex-direction: column; overflow: hidden; }\r\n.search-view { display: flex; flex: 1; min-height: 0; flex-direction: column; }\r\n.query-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 14px; border-bottom: 1px solid var(--border); }\r\n.query-kind-tabs { display: flex; gap: 18px; }\r\n.query-kind-tabs button { padding: 9px 2px; border-bottom: 2px solid transparent; color: var(--muted); font-size: 14px; }\r\n.query-kind-tabs button.active { border-bottom-color: var(--primary); color: var(--primary); font-weight: 600; }\r\n.selection-bar { display: flex; flex-shrink: 0; align-items: center; gap: 10px; min-width: 0; padding: 4px 10px; border-bottom: 1px solid var(--border); background: #f8faff; font-size: 12px; }\r\n.selection-actions { display: flex; flex: 0 1 auto; align-items: center; gap: 10px; min-width: 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #d5dde8 transparent; }\r\n.selection-actions>* { flex-shrink: 0; white-space: nowrap; }\r\n.selection-actions .text-button { padding-block: 3px; font-size: 12px; }\r\n.select-page { display: flex; align-items: center; gap: 7px; color: #475569; cursor: pointer; white-space: nowrap; }\r\n.result-checkbox { width: 17px; height: 17px; margin: 0; accent-color: var(--primary); cursor: pointer; flex-shrink: 0; }\r\n.selection-count { color: #718198; font-size: 12px; white-space: nowrap; }\r\n.bulk-download-button { flex-shrink: 0; margin-left: auto; min-height: 28px; padding: 3px 8px; font-size: 12px; white-space: nowrap; }\r\n.result-card { position: relative; }\r\n.result-card.result-selected { border-color: #6d99d5; box-shadow: 0 0 0 1px #b6ccec; }\r\n.image-select { position: absolute; z-index: 2; top: 8px; right: 8px; display: grid; place-items: center; padding: 5px; background: #fffffff2; border: 1px solid #dfe7f2; border-radius: 5px; }\r\n.result-row-selected { background: #f0f5fd !important; }\r\n.result-table th:nth-child(2) { width: 80px; }\r\n.result-table th:nth-child(3) { width: 30%; }\r\n.active-query-name { display: flex; flex: 1; align-items: center; gap: 5px; min-width: 0; overflow: hidden; color: #7b8899; font-size: 12px; }\r\n.active-query-name>svg { flex-shrink: 0; }\r\n.active-query-name span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\r\n.management-page { overscroll-behavior: contain; }\r\n.import-page { display: flex; flex-direction: column; overflow: hidden; min-height: 0; }\r\n.query-panel { align-self: start; max-height: 100%; overflow: auto; overscroll-behavior: contain; }\r\n.results-panel { display: flex; flex-direction: column; flex: 1; min-height: 0; }\r\n.results-content { flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }\r\n.results-content>.results-empty, .results-content>.no-results, .results-content>.loading-state { min-height: 220px; height: 100%; }\r\n.content-list { overflow: hidden; }\r\n.content-list .result-table-scroll { height: 100%; overflow: auto; }\r\n.result-table thead { position: sticky; top: 0; z-index: 2; }\r\n.search-bottom-note { flex-shrink: 0; }\r\n.nav-icon { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 10px; background: rgba(22,26,29,.04); flex-shrink: 0; color: #374151; }\r\n.collapse-navigation { width: 32px; height: 32px; border-radius: 10px; }\r\n.collapse-navigation:hover { background: rgba(0,0,0,.04); }\r\n.nav-collapsed { --sidebar-width: 45px; }\r\n.nav-collapsed .sidebar-heading { justify-content: center; padding: 0; }\r\n.nav-collapsed .sidebar-heading>span, .nav-collapsed .nav-label, .nav-collapsed .nav-item small, .nav-collapsed .nav-group-label { display: none; }\r\n.nav-collapsed .sidebar nav { padding: 5px 0; }\r\n.nav-collapsed .nav-item { justify-content: center; padding: 5px 0; }\r\n.nav-collapsed .sidebar-bottom { padding-top: 12px; }\r\n.nav-collapsed .sidebar-connection { justify-content: center; padding: 13px 0; }\r\n.nav-collapsed .sidebar-connection>span:not(.status-dot), .nav-collapsed .sidebar-connection>svg, .nav-collapsed .sidebar-footer>div { display: none; }\r\n.nav-collapsed .sidebar-footer { justify-content: center; padding: 14px 0; }\r\n.btn:active:not(:disabled) { transform: translateY(1px); }\r\n.btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(59,130,246,.14); }\r\n.filter-input:focus-within { background: #fff; border-color: rgba(59,130,246,.65); box-shadow: 0 0 0 3px rgba(59,130,246,.12); }\r\n.detail-actions .btn-primary { background: #3b82f6; border-color: rgba(59,130,246,.85); color: #fff; }\r\n.detail-actions .btn-primary:hover:not(:disabled) { background: #2f74e6; color: #fff; }\r\n@media (max-width: 1050px) {\r\n  .search-workspace { grid-template-columns: 300px minmax(0,1fr); }\r\n  .upload-trigger { gap: 8px; }\r\n  .brand { padding-inline: 12px; gap: 8px; }\r\n  .brand b { font-size: 14px; }\r\n  .nav-item { gap: 8px; padding-inline: 9px; }\r\n  .nav-item small { font-size: 12px; }\r\n  .upload-copy b { font-size: 13px; }\r\n  .result-toolbar { gap: 8px; }\r\n  .active-query-name { display: none; }\r\n  .toolbar-select { gap: 4px; }\r\n  .toolbar-select>svg { display: none; }\r\n}\r\n@media (max-width: 760px) {\r\n  .sidebar { transform: translateX(-100%); width: 200px; transition: transform .2s; }\r\n  .nav-collapsed .sidebar-heading>span, .nav-collapsed .nav-label, .nav-collapsed .nav-item small, .nav-collapsed .nav-group-label { display: revert; }\r\n  .nav-collapsed .sidebar-heading { justify-content: space-between; padding: 0 10px; }\r\n  .nav-collapsed .sidebar nav { padding: 5px; }\r\n  .nav-collapsed .nav-item { justify-content: flex-start; padding: 5px 6px; }\r\n  .nav-collapsed .sidebar-connection { justify-content: flex-start; padding: 13px; }\r\n  .nav-collapsed .sidebar-connection>span:not(.status-dot), .nav-collapsed .sidebar-connection>svg, .nav-collapsed .sidebar-footer>div { display: revert; }\r\n  .nav-collapsed .sidebar-footer { justify-content: flex-start; padding: 17px 13px; }\r\n  .collapse-navigation { display: none; }\r\n  .sidebar.sidebar-open { transform: translateX(0); }\r\n  .sidebar-scrim { display: block; position: fixed; inset: 0; z-index: 29; background: #1b2b4250; }\r\n  .main-shell { margin-left: 0; transition: none; }\r\n  .mobile-menu { display: inline-flex; }\r\n  .topbar { padding-inline: 12px; }\r\n  .topbar-actions { gap: 8px; }\r\n  .topbar-title>span { max-width: 230px; font-size: 12px; }\r\n  main { padding: 14px; }\r\n  .search-page { overflow: auto; }\r\n  .search-workspace { display: flex; flex: none; flex-direction: column; gap: 12px; }\r\n  .query-panel { max-height: none; overflow: visible; }\r\n  .query-body { flex-direction: column; align-items: stretch; }\r\n  .query-source { grid-template-columns: 1fr; gap: 8px; }\r\n  .segmented { width: 100%; }\r\n  .query-actions { justify-content: flex-start; }\r\n  .results-panel { flex: none; }\r\n  .results-content { flex: none; overflow: visible; }\r\n  .content-list .result-table-scroll { height: auto; max-height: 460px; overflow: auto; }\r\n  .result-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }\r\n  .result-image-button { aspect-ratio: 1; }\r\n  .upload-copy small { font-size: 12px; }\r\n  .results-heading { gap: 5px; }\r\n  .result-filters { gap: 6px; }\r\n  .filter-input { flex-basis: 145px; min-width: 145px; }\r\n}\r\n@media (max-width: 500px) {\r\n  .topbar { gap: 8px; }\r\n  .topbar-title>span { display: none; }\r\n  .topbar-actions { gap: 3px; }\r\n  .topbar-title h1 { font-size: 16px; }\r\n  .query-toolbar { gap: 8px; padding-inline: 12px; }\r\n  .query-kind-tabs { gap: 12px; }\r\n  .query-source { width: 100%; }\r\n  .segmented { width: 100%; }\r\n  .segmented button { flex: 1; font-size: 13px; padding: 7px; }\r\n  .upload-copy b { font-size: 13px; }\r\n  .upload-copy small { font-size: 12px; }\r\n  .query-actions .search-button { flex: 1; }\r\n  .query-actions .cancel-search { flex-basis: 100%; text-align: center; }\r\n  .panel-heading { padding: 12px; }\r\n  .subtle-label { font-size: 12px; }\r\n  .result-toolbar { padding: 5px 8px; gap: 8px; }\r\n  .selection-bar { padding: 4px 8px; gap: 8px; }\r\n  .toolbar-select select { font-size: 12px; padding-inline: 5px; }\r\n  .view-toggle button { padding: 4px 6px; }\r\n  .result-grid { grid-template-columns: repeat(2,minmax(0,1fr)); padding: 12px; gap: 10px; }\r\n  .score { font-size: 12px; padding: 3px 5px; }\r\n  .result-card-body { padding: 9px 8px 6px; }\r\n  .result-card h3 { font-size: 13px; }\r\n  .result-card-meta { font-size: 12px; }\r\n  .results-empty, .no-results { min-height: 280px; padding-inline: 12px; }\r\n  .empty-steps { gap: 10px; font-size: 12px; }\r\n  .results-footer { padding: 10px 12px; font-size: 12px; }\r\n  .results-footer small { font-size: 12px; }\r\n  .pagination { gap: 6px; }\r\n  .search-bottom-note { font-size: 12px; gap: 8px; }\r\n  .trace-id { max-width: 100%; }\r\n  .dialog { width: calc(100vw - 22px); max-height: 90dvh; }\r\n  .dialog-heading { padding: 11px 13px; }\r\n  .dialog-heading h2 { font-size: 16px; }\r\n  .detail-section { padding: 11px; }\r\n  .detail-summary { gap: 8px; }\r\n  .detail-summary h4 { font-size: 14px; }\r\n  .detail-fields { grid-template-columns: 1fr; gap: 11px; }\r\n  .detail-fields>div { font-size: 13px; grid-template-columns: 70px minmax(0,1fr); }\r\n  .detail-fields dt, .detail-links dt { font-size: 12px; }\r\n  .detail-section>h3 { font-size: 13px; margin-bottom: 12px; }\r\n  .detail-image { height: min(48vh, 340px); min-height: 160px; }\r\n  .detail-links>div, .detail-description { grid-template-columns: 60px minmax(0,1fr); font-size: 12px; }\r\n  .detail-footer { flex-wrap: wrap; gap: 9px; padding: 10px; }\r\n  .detail-footer>p { max-width: none; font-size: 12px; }\r\n  .detail-actions { width: 100%; }\r\n  .detail-actions .btn { font-size: 12px; }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  *, *::before, *::after { animation: none!important; transition: none!important; scroll-behavior: auto!important; }\r\n}\r\n\r\n\r\n/* === index-search-mvp source badge === */\r\n.source-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 2px 7px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n  line-height: 1.4;\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n}\r\n.source-badge-self {\r\n  color: var(--primary);\r\n  background: var(--primary-soft);\r\n  border-color: #c9daf3;\r\n}\r\n.source-badge-flyb {\r\n  color: #6b7280;\r\n  background: #f3f4f6;\r\n  border-color: #e5e7eb;\r\n}\r\n.result-image-button .source-badge {\r\n  position: absolute;\r\n  top: 8px;\r\n  right: 8px;\r\n  z-index: 1;\r\n  background: #fffffff2;\r\n}\r\n.search-target-tabs {\r\n  margin: 0 12px 10px;\r\n  width: calc(100% - 24px);\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n.search-target-batch-note {\r\n  margin: 0 12px 8px;\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n  line-height: 1.5;\r\n}\r\n.source-mode-note {\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n  margin-right: 10px;\r\n}\r\n\r\n/* Query setting cards: 拒识阈值 (自建) and 返回数量 (现网 Global) share one look */\r\n.score-threshold-control,\r\n.search-num-control {\r\n  margin: 0 0 4px;\r\n  padding: 10px 12px;\r\n  border: 1px solid #e1e6ee;\r\n  border-radius: 8px;\r\n  background: #f7f8fa;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.score-threshold-header,\r\n.search-num-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  color: #6b7280;\r\n}\r\n.score-threshold-title,\r\n.search-num-title {\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #334155;\r\n}\r\n.score-threshold-hint,\r\n.search-num-hint {\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n}\r\n.score-threshold-row,\r\n.search-num-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n.score-threshold-slider,\r\n.search-num-slider {\r\n  flex: 1;\r\n  min-width: 0;\r\n  accent-color: var(--primary);\r\n  height: 28px;\r\n}\r\n.score-threshold-number,\r\n.search-num-number {\r\n  width: 76px;\r\n  flex-shrink: 0;\r\n  padding: 6px 8px;\r\n  text-align: center;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.score-threshold-number:disabled,\r\n.score-threshold-slider:disabled,\r\n.search-num-number:disabled,\r\n.search-num-slider:disabled {\r\n  opacity: 0.55;\r\n  cursor: not-allowed;\r\n}\r\n.score-threshold-off {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n  color: #334155;\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n.score-threshold-off input {\r\n  margin: 0;\r\n}\r\n.score-threshold-off:has(input:disabled) {\r\n  opacity: 0.55;\r\n  cursor: not-allowed;\r\n}\r\n.score-threshold-global-note {\r\n  margin: 0;\r\n  font-size: 12px;\r\n  color: var(--muted);\r\n  line-height: 1.45;\r\n}\r\n\r\n/* M6 scene select + heating + label panel */\r\n.scene-select {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 180px;\r\n}\r\n.scene-select-label {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: 12px;\r\n  color: var(--muted, #6b7280);\r\n}\r\n.scene-select-input,\r\n.scene-select .mg-select {\r\n  width: 100%;\r\n}\r\n.query-scene-score {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  margin: 12px 0;\r\n}\r\n.heating-fields {\r\n  display: grid;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n}\r\n.heating-fields div {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n.heating-fields dt {\r\n  color: var(--muted, #6b7280);\r\n  min-width: 4em;\r\n}\r\n.heating-fields-compact {\r\n  display: inline-block;\r\n  font-size: 12px;\r\n  color: var(--muted, #6b7280);\r\n  margin-left: 6px;\r\n}\r\n.no-results-actions {\r\n  margin-top: 12px;\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: center;\r\n}\r\n.mg-library-scene {\r\n  display: inline-block;\r\n  margin-right: 4px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  background: #eef2ff;\r\n  color: #3730a3;\r\n  font-size: 11px;\r\n}\r\n.detail-heating {\r\n  margin-top: 4px;\r\n}\r\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app-shell "},["ASIDE",{"class":"sidebar "},["DIV",{"class":"sidebar-heading"},["SPAN",{},"导航"],["BUTTON",{"class":"icon-button collapse-navigation","aria-label":"收起侧栏","title":"收起侧栏","aria-expanded":"true"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"16","height":"16","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-