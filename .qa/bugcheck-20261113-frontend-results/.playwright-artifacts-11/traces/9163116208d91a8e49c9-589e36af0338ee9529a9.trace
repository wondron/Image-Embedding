{"type":"frame-snapshot","snapshot":{"callId":"zepr@52","phase":"after","pageId":"page@c2d006d9b05fde0bf705b81604fa8d5a","frameId":"frame@ed287ab042ee66eb18cfaa37bb70898f","frameUrl":"http://127.0.0.1:5173/?view=categories","doctype":"html","html":["HTML",{"lang":"zh-CN"},["HEAD",{},["BASE",{"href":"http://127.0.0.1:5173/?view=categories"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"theme-color","content":"#f4f5f7"}],"\n    ",["TITLE",{},"食材图像管理"],"\n    ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],"\n  ",["STYLE",{},"/*\n * The app's feedback (StatusOverlay). Warnings and errors: a frosted modal panel with a status bar on\n * its left edge and a soft glow in its corner, above any open dialog. Success and info: light toasts\n * at the top that never block. Both tinted by type.\n */\n.status-overlay, .so-toast {\n  --so-accent: #3b82f6;\n  --so-accent-2: #60a5fa;\n  --so-ink: #1d4ed8;\n  --so-soft: rgba(59, 130, 246, .12);\n  --so-glow: rgba(59, 130, 246, .24);\n}\n.is-success:is(.status-overlay, .so-toast) { --so-accent: #10b981; --so-accent-2: #34d399; --so-ink: #0f766e; --so-soft: rgba(16, 185, 129, .14); --so-glow: rgba(16, 185, 129, .28); }\n.is-warn:is(.status-overlay, .so-toast) { --so-accent: #f59e0b; --so-accent-2: #fbbf24; --so-ink: #b45309; --so-soft: rgba(245, 158, 11, .15); --so-glow: rgba(245, 158, 11, .22); }\n.is-error:is(.status-overlay, .so-toast) { --so-accent: #ef4444; --so-accent-2: #fb7185; --so-ink: #b42318; --so-soft: rgba(239, 68, 68, .12); --so-glow: rgba(239, 68, 68, .22); }\n\n.status-overlay {\n  width: min(460px, calc(100vw - 32px));\n  max-height: min(80dvh, 640px);\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid rgba(22, 26, 29, .1);\n  border-radius: 16px;\n  background: rgba(255, 255, 255, .95);\n  color: #1f2a3a;\n  box-shadow: 0 26px 90px rgba(15, 23, 42, .2), 0 10px 26px rgba(15, 23, 42, .1);\n}\n.status-overlay[open] { display: flex; animation: so-panel-in 190ms cubic-bezier(.2, .9, .2, 1); }\n.status-overlay::backdrop { background: rgba(15, 23, 42, .26); backdrop-filter: blur(6px); animation: so-mask-in 160ms ease-out; }\n\n.so-panel { position: relative; display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; }\n.so-fx { position: absolute; inset: 0; pointer-events: none; overflow: hidden; border-radius: inherit; }\n.so-fx::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 6px; background: linear-gradient(180deg, var(--so-accent-2), var(--so-accent)); }\n.so-fx::after { content: ''; position: absolute; top: -90px; right: -90px; width: 250px; height: 250px; border-radius: 50%; background: radial-gradient(circle, var(--so-glow), transparent 62%); filter: blur(18px); }\n\n.so-head { position: relative; display: flex; flex-shrink: 0; align-items: center; gap: 10px; padding: 14px 12px 12px 20px; border-bottom: 1px solid rgba(22, 26, 29, .06); }\n.so-badge { display: grid; place-items: center; flex-shrink: 0; width: 30px; height: 30px; border-radius: 10px; background: var(--so-soft); color: var(--so-ink); }\n.so-title { flex: 1; min-width: 0; margin: 0; color: #161a1d; font-size: 15px; font-weight: 800; letter-spacing: .2px; }\n.so-close { display: grid; place-items: center; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; color: #7b8899; }\n.so-close:hover { background: rgba(15, 23, 42, .06); color: #334155; }\n\n.so-body { position: relative; min-height: 0; overflow: auto; padding: 12px 18px 4px 20px; overscroll-behavior: contain; }\n.so-message { margin: 0; color: #3b4656; font-size: 14px; line-height: 1.75; white-space: pre-line; overflow-wrap: anywhere; }\n.so-details { max-height: 200px; margin: 8px 0 0; padding: 8px 10px 8px 26px; overflow: auto; border: 1px solid rgba(22, 26, 29, .07); border-radius: 10px; background: rgba(248, 250, 252, .8); color: #475569; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }\n\n.so-foot { position: relative; display: flex; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; gap: 8px; padding: 12px 16px 16px 20px; }\n.so-ok, .so-action {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  min-width: 84px;\n  height: 36px;\n  padding: 0 16px;\n  border: 1px solid transparent;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 700;\n  text-decoration: none;\n  cursor: pointer;\n  transition: background .12s, border-color .12s, filter .12s;\n}\n.so-ok { background: var(--so-accent); color: #fff; }\n.so-ok:hover { filter: brightness(.95); }\n.so-action { border-color: #d7e2ff; background: #f2f6ff; color: #334155; }\n.so-action:hover { border-color: #c2d2ff; background: #e9efff; color: #334155; }\n.status-overlay :focus-visible { outline: 2px solid #85a8e2; outline-offset: 2px; }\n\n/* What is left before it closes by itself; holds while the pointer is on the panel */\n.so-countdown { position: absolute; left: 6px; right: 0; bottom: 0; height: 3px; background: var(--so-accent); opacity: .55; transform-origin: left center; animation: so-countdown var(--so-duration, 2000ms) linear forwards; }\n.so-countdown.is-paused { animation-play-state: paused; }\n\n/* Toasts: top centre, newest last; only the toasts take the pointer, the gaps never block the page */\n.so-toasts {\n  position: fixed;\n  top: 14px;\n  left: 50%;\n  z-index: 2147483000;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  width: min(440px, calc(100vw - 24px));\n  margin: 0;\n  padding: 0;\n  transform: translateX(-50%);\n  pointer-events: none;\n}\n.so-toast {\n  position: relative;\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n  width: 100%;\n  padding: 10px 8px 11px 16px;\n  overflow: hidden;\n  border: 1px solid rgba(22, 26, 29, .08);\n  border-radius: 12px;\n  background: rgba(255, 255, 255, .97);\n  color: #2b3544;\n  box-shadow: 0 12px 32px rgba(15, 23, 42, .14), 0 3px 8px rgba(15, 23, 42, .06);\n  pointer-events: auto;\n  animation: so-toast-in 180ms cubic-bezier(.2, .9, .2, 1);\n}\n.so-toast::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 4px; background: linear-gradient(180deg, var(--so-accent-2), var(--so-accent)); }\n.so-toast-icon { display: grid; place-items: center; flex-shrink: 0; width: 22px; height: 22px; color: var(--so-ink); }\n.so-toast-text { display: flex; flex: 1; flex-direction: column; min-width: 0; margin: 1px 0 0; font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }\n.so-toast-text strong { color: #161a1d; font-weight: 700; }\n.so-toast-text small { color: #64748b; font-size: 12px; }\n.so-toast-action { display: inline-flex; flex-shrink: 0; align-items: center; gap: 4px; height: 26px; padding: 0 8px; border-radius: 7px; background: var(--so-soft); color: var(--so-ink); font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; }\n.so-toast-action:hover { filter: brightness(.96); color: var(--so-ink); }\n.so-toast-close { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; color: #94a3b8; }\n.so-toast-close:hover { background: rgba(15, 23, 42, .06); color: #334155; }\n.so-toast .so-countdown { left: 4px; height: 2px; }\n.so-toast :focus-visible { outline: 2px solid #85a8e2; outline-offset: 2px; }\n\n@keyframes so-toast-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }\n@keyframes so-panel-in { from { opacity: 0; transform: translateY(10px) scale(.985); } to { opacity: 1; transform: none; } }\n@keyframes so-mask-in { from { opacity: 0; } to { opacity: 1; } }\n@keyframes so-countdown { from { transform: scaleX(1); } to { transform: scaleX(0); } }\n\n@media (max-width: 500px) {\n  .so-head { padding: 12px 10px 10px 18px; }\n  .so-body { padding: 10px 14px 4px 18px; }\n  .so-foot { padding: 10px 12px 14px 18px; }\n  .so-ok, .so-action { flex: 1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .status-overlay[open], .status-overlay::backdrop, .so-toast { animation: none; }\n  .so-countdown { display: none; }\n}\n"],["STYLE",{},"/* A detail view's image: the thumbnail at once, the original over it once loaded (ProgressiveImage) */\n.progressive-image { position: relative; display: grid; width: 100%; height: 100%; min-width: 0; min-height: 0; }\n.progressive-image > img { grid-area: 1 / 1; width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: contain; }\n.progressive-image-full { opacity: 0; transition: opacity .18s ease-out; }\n.progressive-image-full.is-loaded { opacity: 1; }\n.progressive-image-status {\n  position: absolute;\n  right: 8px;\n  bottom: 8px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  max-width: calc(100% - 16px);\n  padding: 3px 9px;\n  border-radius: 999px;\n  background: rgba(15, 23, 42, .62);\n  color: #fff;\n  font-size: 12px;\n  line-height: 1.5;\n  pointer-events: none;\n}\n.progressive-image-status.is-error { background: rgba(154, 103, 0, .88); }\n@media (prefers-reduced-motion: reduce) {\n  .progressive-image-full { transition: none; }\n}\n"],["STYLE",{},".index-task-source-tabs { flex-wrap: wrap; overflow: visible; }\n.index-tasks { min-width: 0; container: index-tasks / inline-size; }\n.index-tasks .mg-page-toolbar { gap: 10px; }\n.index-tasks .mg-tabs { flex-wrap: wrap; overflow: visible; }\n.index-tasks .mg-btn { height: auto; min-height: 38px; padding-block: 8px; white-space: normal; }\n.index-tasks-caption { margin: 10px 0; color: var(--muted); font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.index-tasks-status { display: grid; gap: 8px; margin-bottom: 12px; font-size: 13px; }\n.index-tasks-status p { margin: 0; line-height: 1.7; overflow-wrap: anywhere; }\n.index-tasks-status p[role=\"status\"] { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }\n.index-tasks-status .mg-form-error { margin: 0; }\n.index-tasks-status .mg-btn { margin: 8px 8px 0 0; }\n.index-tasks-status pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 180px; overflow: auto; }\n.index-tasks-head, .index-tasks-row { display: grid; grid-template-columns: minmax(0, 2fr) .6fr minmax(0, 1.1fr) .7fr minmax(0, 1.4fr) auto; gap: 12px; align-items: center; padding: 12px 16px; }\n.index-tasks-head { background: var(--hover); color: var(--muted); font-size: 12px; }\n.index-tasks-row { border-top: 1px solid var(--border); font-size: 13px; }\n.index-tasks-row > *, .index-tasks-meta > * { min-width: 0; overflow-wrap: anywhere; }\n.index-tasks-file { display: flex; align-items: center; gap: 8px; min-width: 0; }\n.index-tasks-file strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }\n.index-task-placeholder { display: inline-grid; place-items: center; color: var(--muted); }\n/* A record whose image was deleted from the library since: kept, but visibly not a live result */\n.index-task-placeholder.is-deleted { color: #98a2b3; background: #f2f4f7; border-style: dashed; }\n.index-tasks-row.is-image-deleted .index-tasks-file strong { color: var(--muted); }\n.index-tasks .index-tasks-status-deleted { color: #667085; }\n.mg-btn.index-tasks-danger { border-color: #c2412f; background: #c2412f; color: #fff; }\n.mg-btn.index-tasks-danger:hover:not(:disabled) { border-color: #a8382a; background: #a8382a; }\n.mg-btn.index-tasks-danger-quiet { border-color: #f1c4be; background: #fdf0ee; color: #b42318; }\n.mg-btn.index-tasks-danger-quiet:hover:not(:disabled) { border-color: #e9a59c; background: #fbe4e0; }\n.mg-btn.index-tasks-danger-quiet:disabled { border-color: var(--border); background: transparent; color: var(--muted); }\n.index-tasks-dialog-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding: 10px 14px; border-top: 1px solid rgba(148, 163, 184, .22); }\n.index-tasks-confirm-inline { flex: 1 1 200px; color: #b42318; font-size: 13px; line-height: 1.6; }\n.index-tasks-confirm { margin: 0; padding: 4px 4px 8px; font-size: 14px; line-height: 1.8; }\n.index-task-details .index-task-deleted-note { display: flex; align-items: flex-start; gap: 6px; color: #475467; }\n.index-task-deleted-note svg { flex-shrink: 0; margin-top: 4px; }\n.index-tasks-meta { display: contents; }\n.index-tasks-label { display: none; color: var(--muted); }\n.index-tasks .mg-job-status { margin-left: 0; }\n.index-tasks-detail-button { justify-self: end; white-space: normal; }\n.index-tasks .mg-pagination { flex-wrap: wrap; }\n.index-tasks .mg-pagination > div { flex-wrap: wrap; }\n.index-task-details { max-height: 65vh; overflow: auto; overflow-wrap: anywhere; padding: 4px; font-size: 14px; line-height: 1.7; }\n.index-task-details dl { margin: 0 0 16px; }\n.index-task-details dl > div { display: grid; grid-template-columns: minmax(90px, 1fr) minmax(0, 3fr); gap: 8px; padding-block: 6px; border-bottom: 1px solid var(--border); }\n.index-task-details dt { color: var(--muted); }\n.index-task-details dd { min-width: 0; margin: 0; white-space: pre-wrap; }\n.index-task-details h3 { margin: 12px 0; font-size: 14px; }\n.index-task-details p { margin: 12px 0; color: var(--muted); }\n@container index-tasks (max-width: 719px) {\n  .index-tasks-head { display: none; }\n  .index-tasks-row { grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }\n  .index-tasks-file strong { white-space: normal; overflow-wrap: anywhere; }\n  .index-tasks-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 16px; }\n  .index-tasks-meta > span { flex: 1 1 120px; }\n  .index-tasks-label { display: inline; }\n  .index-tasks-detail-button { grid-column: 1 / -1; }\n  .index-tasks .mg-metrics { grid-template-columns: 1fr; }\n}\n"],["STYLE",{},"/* 入库任务 · 待清理图片: the deletion queue and its cleanup */\n.deletion-queue { min-width: 0; container: deletion-queue / inline-size; }\n.deletion-queue .mg-page-toolbar { flex-wrap: wrap; gap: 10px; }\n.deletion-queue .mg-btn { height: auto; min-height: 38px; padding-block: 8px; white-space: normal; }\n.deletion-queue-caption { margin: 10px 0; color: var(--muted); font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.deletion-queue-status { display: grid; gap: 8px; margin-bottom: 12px; font-size: 13px; }\n.deletion-queue-status p { margin: 0; line-height: 1.7; overflow-wrap: anywhere; }\n.deletion-queue-status p[role=\"status\"] { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }\n.deletion-queue-status .mg-form-error { margin: 0; }\n.deletion-queue-status .mg-btn { margin: 8px 8px 0 0; }\n.deletion-queue-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 16px; border-top: 1px solid var(--border); font-size: 13px; }\n.deletion-queue-row:first-child { border-top: 0; }\n.deletion-queue-row.is-failed { background: #fff8f6; }\n.deletion-queue-id { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n.deletion-queue-id code { overflow: hidden; color: #334155; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }\n.deletion-queue-id small { color: #b42318; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }\n.deletion-queue-time { color: #64748b; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.deletion-queue-time small { color: var(--muted); }\n.deletion-queue-more { margin: 0; padding: 10px 16px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; }\n@container deletion-queue (max-width: 560px) {\n  .deletion-queue-row { grid-template-columns: auto minmax(0, 1fr); }\n  .deletion-queue-time { grid-column: 2; white-space: normal; }\n  .deletion-queue .mg-metrics { grid-template-columns: 1fr; }\n}\n"],["STYLE",{},"/* Searchable category select: same field look as .mg-field inputs; the tree opens in place. */\n.cp { margin-top: 16px; }\n.cp code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; }\n.cp-label { display: block; color: #7b8899; font-size: 14px; line-height: 1.6; }\n\n.cp-selected { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-top: 7px; padding: 7px 8px 7px 10px; border: 1px solid #cfe0ff; border-radius: 10px; background: #f4f8ff; }\n.cp-selected > div { display: flex; flex-direction: column; min-width: 0; gap: 1px; }\n.cp-selected strong { color: #1f2a3a; font-size: 14px; font-weight: 700; overflow-wrap: anywhere; }\n.cp-selected small { color: #64748b; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }\n.cp-selected code { color: #64748b; }\n.cp-clear { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 6px; color: #64748b; }\n.cp-clear:hover:not(:disabled) { color: #b42318; background: rgba(180, 35, 24, .06); }\n\n.cp-combo { display: flex; align-items: center; gap: 7px; min-height: 38px; margin-top: 7px; padding: 0 10px; border: 1px solid #d7e0ee; border-radius: 10px; background: #fff; color: #7b8899; }\n.cp-combo:focus-within { border-color: #9ab4dc; box-shadow: 0 0 0 3px rgba(59, 130, 246, .1); }\n.cp-combo.is-open { border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }\n.cp.is-invalid .cp-combo, .cp.is-invalid .cp-selected { border-color: #f0c2bc; }\n.cp-combo input { flex: 1; min-width: 0; height: 36px; padding: 0; border: 0; outline: 0; background: transparent; color: #223046; font-size: 14px; }\n.cp-combo input::placeholder { color: #7b8aa0; }\n.cp-combo input:disabled { cursor: not-allowed; }\n.cp-combo input:focus-visible, .mg-page .cp-combo input:focus-visible { outline: 0; }  /* the box around it shows the focus */\n\n/* What was picked last: one click instead of a search */\n.cp-recent { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-top: 6px; color: #a3afbf; }\n.cp-recent-chip { max-width: 132px; height: 24px; padding: 0 9px; overflow: hidden; border: 1px solid #e3e8f0; border-radius: 999px; background: #f8fafc; color: #475569; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }\n.cp-recent-chip:hover { border-color: #c4d3ea; background: #f4f8ff; color: var(--primary); }\n\n/* The tree (nothing typed) or the matches (something typed): one line per category, so nine fit */\n.cp-list { max-height: 300px; margin: 4px 0 0; padding: 4px; overflow: auto; list-style: none; border: 1px solid #d7e0ee; border-radius: 4px 4px 10px 10px; background: #fff; box-shadow: 0 6px 16px rgba(15, 23, 42, .06); overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #d5dde8 transparent; }\n.cp-option { display: flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 8px 0 4px; border-radius: 6px; color: #223046; font-size: 14px; white-space: nowrap; cursor: pointer; user-select: none; }\n.cp-list.is-results .cp-option { padding-left: 10px; }\n.cp-option.is-active { background: #eef4ff; }\n.cp-option.is-selected .cp-option-label { color: var(--primary); font-weight: 700; }\n.cp-option.is-all { margin-bottom: 3px; padding-left: 10px; border-bottom: 1px solid #eef2f7; border-radius: 6px 6px 0 0; color: #475569; }\n.cp-option.is-context { cursor: default; }\n.cp-option.is-context .cp-option-label { color: #8a96a8; }\n.cp-twisty { display: grid; place-items: center; flex-shrink: 0; width: 22px; height: 26px; margin-right: -3px; border-radius: 5px; color: #94a3b8; }\n.cp-twisty svg { transition: transform .12s; }\n.cp-twisty.is-open svg { transform: rotate(90deg); }\n.cp-twisty.is-toggle { cursor: pointer; }\n.cp-twisty.is-toggle:hover { color: #334155; background: rgba(15, 23, 42, .07); }\n.cp-option-label { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }\n.cp-option-matched { flex: 0 2 auto; min-width: 0; overflow: hidden; padding: 0 6px; border-radius: 999px; background: #fff6d6; color: #7a5b00; font-size: 12px; line-height: 20px; text-overflow: ellipsis; }\n.cp-option-path { flex: 1 3 0; min-width: 0; overflow: hidden; color: #7b8899; font-size: 12px; text-overflow: ellipsis; }\n.cp-option-code { flex: 0 4 auto; min-width: 0; margin-left: auto; overflow: hidden; color: #a3afbf; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; text-overflow: ellipsis; }\n.cp-option-count { flex-shrink: 0; min-width: 20px; margin-left: auto; color: #a3afbf; font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; }\n.cp-off { flex-shrink: 0; padding: 0 5px; border-radius: 999px; background: #f1f3f6; color: #94a3b8; font-size: 11px; line-height: 17px; }\n.cp-empty, .cp-more { padding: 8px 10px; color: #7b8899; font-size: 12px; line-height: 1.6; }\n.cp-inactive { align-self: flex-start; padding: 0 6px; border-radius: 999px; background: #fdf0ee; color: #b42318 !important; }\n\n.cp-hint { margin: 5px 0 0; color: #7b8899; font-size: 12px; line-height: 1.7; }\n.cp-error { margin: 5px 0 0; color: #b42318; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.cp-error .mg-text-button { font-size: 12px; }\n"],["STYLE",{},"/* Image annotation fields shared by the upload form and the gallery editor. Tokens follow ManagementViews. */\n.ia-form { display: flex; flex-direction: column; gap: 10px; }\n.ia-form code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; }\n.ia-section { padding: 12px 14px 14px; border: 1px solid #edf1f7; border-radius: 10px; background: #fcfdff; }\n.ia-section > h3,\n.ia-collapsible > summary h3 { margin: 0; color: #1f2a3a; font-size: 14px; font-weight: 800; }\n.ia-section > .cp:first-of-type { margin-top: 10px; }\n\n.ia-collapsible > summary { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; list-style: none; cursor: pointer; }\n.ia-collapsible > summary::-webkit-details-marker { display: none; }\n.ia-collapsible > summary::before { content: ''; flex-shrink: 0; align-self: center; width: 6px; height: 6px; margin-right: 2px; border-right: 1.5px solid #7b8899; border-bottom: 1.5px solid #7b8899; transform: rotate(-45deg); transition: transform .15s; }\n.ia-collapsible[open] > summary::before { transform: rotate(45deg); }\n.ia-collapsible > summary h3 { flex: 1; }\n.ia-collapsible > summary small { color: #7b8899; font-size: 12px; font-weight: 400; text-align: right; overflow-wrap: anywhere; }\n.ia-collapsible > summary:focus-visible { outline: 2px solid #87a6d3; outline-offset: 2px; border-radius: 4px; }\n\n.ia-field { margin-top: 12px; min-width: 0; }\n.ia-field > label { display: block; color: #7b8899; font-size: 13px; line-height: 1.6; }\n.ia-field > textarea,\n.ia-field > select { display: block; box-sizing: border-box; width: 100%; margin-top: 5px; padding: 6px 10px; border: 1px solid #d7e0ee; border-radius: 10px; background: #fff; color: #223046; font-family: inherit; font-size: 14px; line-height: 1.6; }\n.ia-field > select { min-height: 36px; }\n.ia-field > textarea { min-height: 72px; resize: vertical; }\n.ia-field > textarea[aria-invalid=\"true\"] { border-color: #f0c2bc; }\n.ia-field textarea::placeholder,\n.ia-field input::placeholder { color: #7b8aa0; }\n.ia-counter { display: block; margin-top: 4px; color: #7b8899; font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; }\n.ia-counter.is-over { color: #b42318; text-align: left; }\n.ia-field-error { display: block; margin-top: 4px; color: #b42318; font-size: 12px; line-height: 1.6; }\n.ia-field-note { display: block; margin-top: 4px; color: #9a6700; font-size: 12px; line-height: 1.6; }\n.ia-muted { margin: 10px 0 0; color: #7b8899; font-size: 12px; line-height: 1.8; }\n.ia-inline-error { margin: 8px 0 0; color: #b42318; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\n.ia-inline-error .mg-text-button { font-size: 12px; }\n\n.ia-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 10px; }\n.ia-unit { display: flex; align-items: center; margin-top: 5px; border: 1px solid #d7e0ee; border-radius: 10px; background: #fff; overflow: hidden; }\n.ia-unit:focus-within { border-color: #9ab4dc; box-shadow: 0 0 0 3px rgba(59, 130, 246, .1); }\n.ia-unit.is-invalid { border-color: #f0c2bc; }\n.ia-unit input { flex: 1; min-width: 0; height: 34px; padding: 0 10px; border: 0; outline: 0; background: transparent; color: #223046; font-size: 14px; font-variant-numeric: tabular-nums; }\n.mg-page .ia-unit input:focus-visible,\n.dialog .ia-unit input:focus-visible { outline: 0; }\n.ia-unit > span { padding: 0 10px; color: #7b8899; font-size: 12px; }\n\n.ia-choice { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin: 12px 0 0; padding: 0; border: 0; }\n.ia-choice legend { float: left; width: 100%; margin-bottom: 4px; padding: 0; color: #7b8899; font-size: 13px; }\n.ia-choice label { display: inline-flex; align-items: center; gap: 6px; color: #223046; font-size: 14px; cursor: pointer; }\n.ia-choice small { width: 100%; color: #7b8899; font-size: 12px; line-height: 1.7; }\n.ia-choice input { margin: 0; accent-color: var(--primary); }\n\n.ia-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; min-height: 38px; margin-top: 5px; padding: 4px 8px; border: 1px solid #d7e0ee; border-radius: 10px; background: #fff; cursor: text; }\n.ia-tags:focus-within { border-color: #9ab4dc; box-shadow: 0 0 0 3px rgba(59, 130, 246, .1); }\n.ia-tags.is-invalid { border-color: #f0c2bc; }\n.ia-tags.is-disabled { cursor: not-allowed; opacity: .7; }\n.ia-tags input { flex: 1; min-width: 90px; height: 28px; padding: 0 2px; border: 0; outline: 0; background: transparent; color: #223046; font-size: 14px; }\n.mg-page .ia-tags input:focus-visible,\n.dialog .ia-tags input:focus-visible { outline: 0; }\n.ia-tag { display: inline-flex; align-items: center; gap: 3px; max-width: 100%; padding: 1px 4px 1px 8px; border: 1px solid #dfe6f1; border-radius: 6px; background: #f6f8fb; color: #334155; font-size: 13px; overflow-wrap: anywhere; }\n.ia-tag button { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 4px; color: #7b8899; }\n.ia-tag button:hover:not(:disabled) { color: #b42318; background: rgba(180, 35, 24, .06); }\n\n@media (max-width: 420px) {\n  .ia-grid { grid-template-columns: 1fr; }\n}\n"],["STYLE",{},"/* Gallery image editor (inside the 「图片标注」 dialog). Field styles: features/annotation-fields. */\n/* Only LibraryPage's ImageEditPanel uses .ie in a Dialog. Do not reuse this root\n   for other dialogs: the explicit border-box block-size is gallery-specific. */\n.dialog.dialog-wide:has(.ie) {\n  width: min(840px, calc(100vw - 30px));\n  block-size: min(720px, 90dvh);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.dialog-body:has(.ie) {\n  flex: 1;\n  min-block-size: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.ie { display: flex; flex: 1; flex-direction: column; min-block-size: 0; min-inline-size: 0; gap: 0; padding: 0; }\n/* Single-column default: only main scrolls; the inner content is not a second scroller. */\n.ie-main { flex: 1; min-block-size: 0; min-inline-size: 0; overflow: auto; overscroll-behavior: contain; }\n.ie-rail { min-inline-size: 0; min-block-size: auto; overflow: visible; padding: 12px 16px 16px; }\n.ie-scroll { display: flex; flex-direction: column; gap: 10px; min-inline-size: 0; min-block-size: auto; overflow: visible; padding: 12px 16px 16px; container: ie-editor / inline-size; }\n/* The photo at its own proportions (inline aspect-ratio from its width / height; 4:3 until\n   known), never taller than the cap: no grey bars around a landscape photo. */\n.ie-figure { position: relative; display: grid; place-items: center; margin: 0; inline-size: 100%; aspect-ratio: 4 / 3; max-block-size: min(34dvh, 260px); min-block-size: 120px; min-inline-size: 0; overflow: hidden; border: 1px solid #e5e9f0; border-radius: 10px; background: #f2f4f8; }\n.ie-figure img { width: 100%; height: 100%; object-fit: contain; }\n.ie-figure > .progressive-image { width: 100%; height: 100%; }\n.ie-noimage { color: #94a3b8; font-size: 13px; }\n/* The thumbnail is a button: a click opens the large view (the original loads only there) */\n.ie-figure-open { position: relative; display: grid; place-items: center; inline-size: 100%; block-size: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: zoom-in; }\n.ie-figure-open:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; border-radius: 10px; }\n.ie-zoom-hint { position: absolute; inset-block-end: 8px; inset-inline-end: 8px; display: inline-flex; align-items: center; gap: 4px; padding: 2px 9px; border-radius: 999px; background: rgba(15, 23, 42, .58); color: #fff; font-size: 12px; line-height: 20px; opacity: .88; transition: opacity .15s, background .15s; pointer-events: none; }\n.ie-figure-open:hover .ie-zoom-hint, .ie-figure-open:focus-visible .ie-zoom-hint { background: rgba(15, 23, 42, .78); opacity: 1; }\n\n/* The large view (a dialog of its own next to the editor). Only the dialog whose own body holds\n   it: the editor's dialog contains this one, so a plain :has(.ie-zoom) would resize it too. */\n.dialog.dialog-wide:has(> .dialog-body > .ie-zoom) { width: min(1100px, calc(100vw - 30px)); }\n/* The photo's own proportions (inline aspect-ratio), capped in height: a landscape photo gets\n   no tall dark bands, a portrait one is letterboxed at the sides */\n.ie-zoom { display: grid; place-items: center; inline-size: 100%; max-block-size: min(76dvh, 860px); background: #111827; }\n.ie-zoom > .progressive-image { width: 100%; height: 100%; }\n.ie-zoom img { width: 100%; height: 100%; object-fit: contain; }\n.ie-zoom .ie-noimage { color: #94a3b8; }\n.ie-zoom-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px; padding: 8px 14px; border-top: 1px solid #e6ebf3; color: #64748b; font-size: 13px; }\n.ie-zoom-bar a { display: inline-flex; align-items: center; gap: 4px; color: var(--primary); text-decoration: none; }\n.ie-zoom-bar a:hover { text-decoration: underline; }\n@media (max-width: 500px) {\n  .ie-zoom { max-block-size: min(64dvh, 560px); }\n}\n.ie-facts { min-width: 0; margin-block-start: 12px; padding: 10px 12px 12px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fcfdff; container: ie-saved / inline-size; }\n.ie-facts > h3 { margin: 0 0 8px; color: #1f2a3a; font-size: 13px; font-weight: 800; }\n.ie-meta { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px 16px; margin: 0; }\n.ie-meta > div { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 8px; align-items: baseline; min-width: 0; }\n.ie-meta dt { color: #7b8899; font-size: 12px; line-height: 1.6; }\n.ie-meta dd { margin: 0; color: #223046; font-size: 13px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }\n.ie-meta-wide { grid-column: 1 / -1; }\n.ie-muted { color: #94a3b8; font-weight: 400; }\n.ie-chips { display: inline-flex; flex-wrap: wrap; gap: 4px; }\n.ie-chip { display: inline-block; padding: 0 8px; border-radius: 999px; background: #eef2f7; color: #475569; font-size: 12px; font-weight: 500; line-height: 20px; white-space: nowrap; }\n.ie-chip.is-auto { background: #eaf2ff; color: #1d4ed8; }\n.ie-chip.is-verified { background: #eaf5ee; color: #2f7d4a; }\n.ie-chip.is-unlabeled { background: #f3f4f6; color: #6b7280; }\n/* One line: the id is copied with the button, not read off the screen */\n.ie-id { display: flex; align-items: center; gap: 4px; min-width: 0; }\n.ie-id code { min-width: 0; overflow: hidden; color: #475569; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }\n.ie-copy { display: inline-grid; place-items: center; flex-shrink: 0; inline-size: 24px; block-size: 24px; padding: 0; border: 0; border-radius: 6px; background: none; color: #7b8899; cursor: pointer; }\n.ie-copy:hover, .ie-copy:focus-visible { background: #eef2f7; color: var(--primary); }\n/* Only the saved-information content box controls metadata columns. The 300px rail\n   never reaches 664px; wide single-column layouts may fit two label/value fields. */\n@container ie-saved (min-width: 664px) {\n  .ie-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n/* v0.4: four independent rows, never pair unlike compound controls side by side.\n   Only this gallery form owns the label rail; shared field semantics stay intact. */\n.ie .ia-section { padding: 10px 12px 12px; }\n.ie .ia-field { margin-top: 8px; }\n.ie-field-rows { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; min-inline-size: 0; }\n.ie-category-picker { min-inline-size: 0; }\n.ie .ie-category-picker > .cp,\n.ie .ie-line-field { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px 12px; min-inline-size: 0; margin: 0; }\n.ie .ie-category-picker > .cp { row-gap: 6px; }\n.ie .ie-category-picker > .cp > .cp-label { font-size: 13px; line-height: 1.6; }\n.ie .ie-category-picker > .cp > .cp-selected,\n.ie .ie-line-field > .ia-tags,\n.ie .ie-line-field > textarea { margin-top: 0; }\n.ie .ie-field-rows .cp-combo { margin-top: 0; }\n.ie .ie-category-picker > .cp > .cp-hint,\n.ie .ie-category-picker > .cp > .cp-error { margin: 0; }\n/* Keep the real name/path/code nodes, but share one bounded text line. The\n   clear button remains outside this shrinking text box with its native 24px size. */\n.ie .ie-category-picker .cp-selected { align-items: center; min-inline-size: 0; }\n.ie .ie-category-picker .cp-selected > div { flex: 1; flex-direction: row; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; }\n.ie .ie-category-picker .cp-selected > div > :not(.cp-inactive) { min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.ie .ie-category-picker .cp-selected strong { flex: 0 1 auto; max-inline-size: 30%; }\n.ie .ie-category-picker .cp-selected small:not(.cp-inactive),\n.ie .ie-category-picker .cp-selected code { flex: 1 1 0; }\n.ie .ie-category-picker .cp-inactive { flex: 0 0 auto; align-self: center; white-space: nowrap; }\n.ie .ie-line-field > small { margin-top: 0; }\n/* Only this description grows with its value; keep all other textarea behavior. */\n.ie .ie-line-field > .ie-description { min-height: 0; overflow-y: hidden; resize: none; }\n/* Keep a real fieldset/legend. Only the legend is positioned in the wide label rail;\n   the radios and their full help text remain in normal, wrapping document flow. */\n.ie .ie-status-row { position: relative; display: block; margin: 0; padding: 0; min-inline-size: 0; }\n.ie .ie-status-row > legend { float: none; width: auto; margin: 0 0 6px; padding: 0; }\n.ie-status-control { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; min-inline-size: 0; }\n.ie-status-control > label { min-block-size: 36px; }\n/* Narrow content: labels above. Wide content: one shared 80px label rail and a\n   full remaining control column, not a second independently-sized field. */\n@container ie-editor (min-width: 420px) {\n  .ie .ie-category-picker > .cp,\n  .ie .ie-line-field { grid-template-columns: 80px minmax(0, 1fr); }\n  .ie .ie-category-picker > .cp > label,\n  .ie .ie-line-field > label { grid-column: 1; grid-row: 1; padding-block-start: 7px; }\n  .ie .ie-category-picker > .cp > :not(label),\n  .ie .ie-line-field > :not(label) { grid-column: 2; min-inline-size: 0; }\n  .ie .ie-status-row { padding-inline-start: 92px; }\n  .ie .ie-status-row > legend { position: absolute; inset-block-start: 0; inset-inline-start: 0; inline-size: 80px; margin: 0; padding-block-start: 7px; }\n}\n/* Preserve the existing food-field content-width guard; v0.4 replaces ONLY the\n   category/status and tags/description pairings, not FoodFields layout. */\n.ie .ia-grid { grid-template-columns: minmax(0, 1fr); }\n@container ie-editor (min-width: 460px) {\n  .ie .ia-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n.ie-vector { padding: 9px 12px 10px; border: 1px solid #e5eaf2; border-radius: 10px; background: #fcfdff; }\n.ie-vector-head { display: flex; align-items: center; gap: 8px; }\n.ie-vector-head strong { color: #1f2a3a; font-size: 13px; }\n.ie-vector-head .mg-text-button { margin-left: auto; font-size: 12px; }\n.ie-vector-head .mg-text-button:disabled { color: var(--muted); cursor: not-allowed; text-decoration: none; }\n.ie-vector-badge { padding: 0 8px; border-radius: 999px; font-size: 11px; line-height: 18px; }\n.ie-vector.is-synced .ie-vector-badge { background: #eaf5ee; color: #2f7d4a; }\n.ie-vector.is-stale { border-color: #f1dcb8; background: #fffaf2; }\n.ie-vector.is-stale .ie-vector-badge { background: #fff4e5; color: #9a6700; }\n.ie-vector.is-missing { border-color: #f0c2bc; background: #fffafa; }\n.ie-vector.is-missing .ie-vector-badge { background: #fdf0ee; color: #b42318; }\n.ie-vector.is-unavailable .ie-vector-badge { background: #eef2f7; color: #64748b; }\n.ie-vector p { margin: 5px 0 0; color: #475569; font-size: 12px; line-height: 1.7; }\n/* What lags: one row per field, the vector store's value next to the database's */\n.ie-diff { width: 100%; margin: 8px 0 0; border-collapse: collapse; font-size: 12px; line-height: 1.6; table-layout: fixed; }\n.ie-diff th, .ie-diff td { padding: 4px 8px; border-bottom: 1px solid #f1e3c8; text-align: left; vertical-align: top; overflow-wrap: anywhere; }\n.ie-diff thead th { color: #9a7b45; font-weight: 600; }\n.ie-diff thead th:first-child { width: 72px; }\n.ie-diff tbody th { color: #7a5a1f; font-weight: 700; }\n.ie-diff tbody td:nth-child(2) { color: #9a6700; text-decoration: line-through; text-decoration-color: rgba(154, 103, 0, .45); }\n.ie-diff tbody td:nth-child(3) { color: #223046; font-weight: 600; }\n.ie-diff tbody tr:last-child th, .ie-diff tbody tr:last-child td { border-bottom: 0; }\n.ie-vector-action { height: 32px; margin-top: 10px; padding: 0 12px; font-size: 13px; }\n.ie-vector-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; }\n.ie-vector-actions .ie-vector-link { margin-top: 10px; }\n.ie-vector-link { margin-top: 6px; font-size: 12px; }\n.ie-vector-link:disabled { color: var(--muted); cursor: not-allowed; text-decoration: none; }\n/* The collection, versions and ledger: for whoever debugs a sync, out of the way otherwise */\n.ie-tech { margin-top: 8px; color: #7b8899; font-size: 11px; }\n.ie-tech summary { width: max-content; cursor: pointer; }\n.ie-tech summary:hover { color: var(--primary); }\n.ie-tech dl { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 3px 10px; margin: 6px 0 0; }\n.ie-tech dl > div { display: contents; }\n.ie-tech dt { color: #94a3b8; }\n.ie-tech dd { margin: 0; color: #64748b; line-height: 1.6; overflow-wrap: anywhere; }\n.ie-tech code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; }\n.ie-tech-note { color: #9a6700; }\n.ie-tech-ledger { display: block; }\n.ie-tech-raw { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\n\n/* Vector sync sits right under the photo in the scrolling rail (what search sees comes first).\n   Keep every field/action; wrap long identifiers and let buttons grow if needed. */\n.ie-rail > .ie-vector { margin-block-start: 12px; padding: 8px 10px 10px; }\n.ie-rail .ie-vector-head { flex-wrap: wrap; gap: 6px; }\n.ie-rail .ie-diff th, .ie-rail .ie-diff td { padding: 4px 5px; }\n.ie-rail .ie-diff thead th:first-child { width: 64px; }\n.ie-rail .ie-tech dl { grid-template-columns: 56px minmax(0, 1fr); gap: 3px 8px; }\n.ie .ie-rail .ie-vector-action { max-inline-size: 100%; height: auto; min-height: 32px; padding: 6px 8px; white-space: normal; }\n.ie .ie-rail .ie-vector-link { max-inline-size: 100%; white-space: normal; text-align: left; }\n.ie-rail .ie-vector-action svg, .ie-rail .ie-vector-link svg { flex-shrink: 0; }\n\n.ie-status { display: flex; align-items: center; gap: 6px; margin: 0; color: #64748b; font-size: 13px; }\n.ie-alert { margin: 0; padding: 8px 10px; border: 1px solid #f0c2bc; border-radius: 8px; background: #fffafa; color: #b42318; font-size: 13px; line-height: 1.6; }\n.ie-alert .mg-text-button { font-size: 13px; }\n/* A card like the form sections above it */\n.ie-memberships { min-inline-size: 0; padding: 10px 12px 12px; border: 1px solid #edf1f7; border-radius: 10px; background: #fcfdff; }\n.ie-memberships .scene-membership-panel { margin: 0; min-inline-size: 0; }\n.ie-memberships .scene-table-scroll { max-inline-size: 100%; overflow-x: auto; }\n.ie-memberships .scene-table th, .ie-memberships .scene-table td { padding: 8px 10px; }\n.ie .ie-vector { min-inline-size: 0; overflow-wrap: anywhere; }\n.ie-figure .progressive-image-status { overflow-wrap: anywhere; }\n\n/* Typography only inside this gallery editor. Paragraph/status colors are NOT reset:\n   alerts retain their existing semantic classes/colors from the shared panel. */\n.ie .scene-membership-panel { font-family: inherit; font-size: 13px; line-height: 1.6; color: #223046; }\n.ie .scene-membership-head h4 { margin: 0; font-size: 14px; font-weight: 800; line-height: 1.6; color: #1f2a3a; }\n.ie .scene-membership-panel .text-button { font-family: inherit; font-size: 13px; font-weight: 400; line-height: 1.6; }\n.ie .scene-membership-panel > p { font-size: 13px; line-height: 1.6; }\n.ie-memberships .scene-table th { font-size: 12px; font-weight: 600; line-height: 1.6; color: #7b8899; }\n.ie-memberships .scene-membership-table th small { font-size: 12px; font-weight: 400; color: #7b8899; }\n.ie-memberships .scene-table td { font-size: 13px; font-weight: 400; line-height: 1.6; color: #223046; }\n.ie .scene-membership-source.is-manual { font-weight: 600; }\n.ie .scene-membership-panel .mg-help { font-size: 12px !important; font-weight: 400; line-height: 1.8 !important; color: #7b8899 !important; }\n.ie .scene-membership-panel > small { font-size: 12px; font-weight: 400; line-height: 1.8; color: #7b8899; }\n.ie .scene-inactive-tag { font-size: 12px; font-weight: 400; }\n.ie .scene-membership-panel code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }\n\n/* A non-sticky last flex row in this explicitly sized dialog. Confirmation may scroll\n   inside the footer; 40% is relative to the filled .ie, not the viewport. */\n.ie-bar { position: static; flex-shrink: 0; min-block-size: 0; max-block-size: min(220px, 40%); overflow: auto; overscroll-behavior: contain; z-index: 2; display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 10px 12px; border-top: 1px solid rgba(148, 163, 184, .22); background: rgba(252, 253, 255, .97); }\n.ie-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n.ie-changes { flex: 1; min-width: 0; color: #7b8899; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.ie-delete { color: #b42318; }\n.ie-delete:disabled { color: var(--muted); cursor: not-allowed; text-decoration: none; }\n.ie-ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; padding: 8px 10px; border: 1px solid #f0c2bc; border-radius: 8px; background: #fffafa; }\n.ie-ask p { flex: 1 1 260px; margin: 0; color: #7a2e26; font-size: 13px; line-height: 1.6; }\n.ie-ask > div { display: flex; gap: 8px; }\n.ie-danger { color: #fff; background: #c2412f; border-color: #c2412f; }\n.ie-danger:hover:not(:disabled) { background: #a8382a; border-color: #a8382a; }\n\n/* The entire rail (preview AND saved fields) scrolls independently, inset like the form\n   column. Never make the preview sticky: it must not cover the saved values below it. */\n@media (min-width: 900px) and (min-height: 640px) {\n  .ie-main {\n    display: grid;\n    grid-template-columns: 292px minmax(0, 1fr);\n    grid-template-rows: minmax(0, 1fr);\n    gap: 4px;\n    overflow: hidden;\n  }\n  .ie-rail { min-block-size: 0; overflow: auto; overscroll-behavior: contain; padding: 12px 0 16px 16px; scrollbar-width: thin; }\n  .ie-rail .ie-figure { max-block-size: 200px; }\n  .ie-scroll { min-block-size: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }\n}\n@media (min-width: 900px) and (min-height: 760px) {\n  .ie-rail .ie-figure { max-block-size: 240px; }\n}\n@media (max-width: 640px) {\n  .ie-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }\n  .ie-actions > .mg-btn { min-block-size: 36px; block-size: auto; padding-block: 8px; }\n  .ie-ask .mg-btn { min-block-size: 36px; block-size: auto; padding-block: 8px; }\n  .ie-ask > div { margin-inline-start: auto; }\n}\n@media (max-width: 500px) {\n  .dialog.dialog-wide:has(.ie) { width: calc(100vw - 22px); block-size: min(820px, 90dvh); }\n}\n"],["STYLE",{},"/*\n * 图片数据 · the tool column: compact filter rows on top, the category tree below taking the rest\n * of the column's height (it is the control that has to carry thousands of categories).\n */\n.lf-panel {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  overscroll-behavior: contain;\n  scrollbar-width: thin;\n  scrollbar-color: #d5dde8 transparent;\n  background: #fff;\n  border: 1px solid rgba(148, 163, 184, .25);\n  border-radius: 12px;\n}\n\n.lf-head {\n  position: sticky;\n  top: 0;\n  z-index: 3;\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 7px;\n  min-height: 46px;\n  padding: 0 12px 0 14px;\n  border-bottom: 1px solid var(--border);\n  background: rgba(255, 255, 255, .97);\n  color: #64748b;\n}\n.lf-head h2 { font-size: 14px; font-weight: 700; color: #334155; }\n.lf-badge {\n  min-width: 18px;\n  padding: 0 6px;\n  border-radius: 999px;\n  background: var(--primary-soft);\n  color: var(--primary);\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 18px;\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n.lf-help-toggle { margin-left: auto; }\n.lf-help-toggle[aria-expanded=\"true\"] { color: var(--primary); background: #eff4fb; }\n.lf-reset { margin-left: 2px; }\n.lf-head > .lf-badge + .lf-reset, .lf-head > h2 + .lf-reset { margin-left: auto; }\n.lf-reset:disabled { color: #a5afbd; cursor: default; text-decoration: none; }\n.lf-toggle { display: none; }\n\n.lf-body { display: flex; flex: 1 0 auto; flex-direction: column; }\n\n.lf-help { padding: 10px 14px 12px; border-bottom: 1px solid #eef1f6; background: #f8faff; color: #64748b; font-size: 12px; line-height: 1.75; }\n.lf-help p { margin: 0; }\n.lf-help p + p { margin-top: 6px; }\n\n/* Compact rows: a short label beside its control */\n.lf-filters { display: flex; flex-direction: column; gap: 8px; padding: 12px; border-bottom: 1px solid #eef1f6; }\n.lf-row { display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: center; gap: 6px 8px; min-width: 0; }\n.lf-row-label { color: #64748b; font-size: 12px; font-weight: 600; white-space: nowrap; }\n\n.lf-input {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  height: 36px;\n  min-width: 0;\n  margin: 0;\n  padding: 0 6px 0 10px;\n  border: 1px solid #d7e0ee;\n  border-radius: 9px;\n  background: #fff;\n  color: #7b8899;\n}\n.lf-input:focus-within { border-color: #9ab4dc; box-shadow: 0 0 0 3px rgba(59, 130, 246, .1); }\n.lf-input input {\n  flex: 1;\n  min-width: 0;\n  height: 100%;\n  padding: 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: #223046;\n  font: inherit;\n  font-size: 14px;\n  -webkit-appearance: none;\n  appearance: none;\n}\n.lf-input input::placeholder { color: #94a3b8; }\n.lf-input input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }\n.lf-input input:disabled { cursor: not-allowed; }\n.mg-page .lf-input input:focus-visible { outline: 0; }\n.lf-clear { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 6px; color: #94a3b8; }\n.lf-clear:hover { color: #475569; background: #f1f5f9; }\n\n/* One-of choices, styled like the search page's segmented control; native radios inside */\n.lf-segment { display: flex; min-width: 0; padding: 2px; border: 1px solid #e1e6ee; border-radius: 8px; background: #f7f8fa; }\n.lf-segment label { position: relative; display: flex; flex: 1 1 auto; min-width: 0; cursor: pointer; }\n.lf-segment input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }\n.lf-segment span {\n  display: flex;\n  flex: 1;\n  align-items: center;\n  justify-content: center;\n  height: 28px;\n  padding: 0 4px;\n  border-radius: 6px;\n  color: #6b7280;\n  font-size: 13px;\n  white-space: nowrap;\n  transition: background .12s, color .12s, box-shadow .12s;\n}\n.lf-segment label:hover input:not(:checked) + span { color: #334155; }\n.lf-segment input:checked + span { background: #fff; color: var(--primary); font-weight: 600; box-shadow: 0 0 0 1px #e1e7f1, 0 1px 2px rgba(15, 23, 42, .05); }\n.lf-segment input:focus-visible + span { outline: 2px solid #85a8e2; outline-offset: 1px; }\n.mg-page .lf-segment input:focus-visible { outline: 0; }\n\n/* The shared scene select as one row: label, select, refresh icon */\n.scene-select.lf-scene { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 6px 8px; min-width: 0; }\n.lf-scene .scene-select-label { gap: 0; color: #64748b; font-size: 12px; font-weight: 600; }\n.lf-scene .scene-select-label svg { display: none; }\n.lf-scene .mg-select { width: 100%; min-width: 0; height: 36px; }\n.lf-scene > p { grid-column: 1 / -1; margin: 0 !important; }\n.scene-select-refresh { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; color: #94a3b8; }\n.scene-select-refresh:hover:not(:disabled) { color: var(--primary); background: #eff4fb; }\n\n.lf-applied-chip {\n  display: inline-flex;\n  grid-column: 2;\n  justify-self: start;\n  align-items: center;\n  gap: 3px;\n  max-width: 100%;\n  height: 26px;\n  padding: 0 3px 0 10px;\n  border: 1px solid #cfe0ff;\n  border-radius: 999px;\n  background: #f4f8ff;\n  color: var(--primary);\n  font-size: 13px;\n  font-weight: 600;\n}\n.lf-applied-chip > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.lf-applied-chip button { display: grid; place-items: center; flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; color: #5b7bb5; }\n.lf-applied-chip button:hover { color: #b42318; background: #fdf0ee; }\n\n.lf-icon-button { display: grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 7px; color: #94a3b8; }\n.lf-icon-button:hover { color: var(--primary); background: #eff4fb; }\n\n/* Category: fills what is left of the column; the tree takes the rest of it */\n.lf-category { display: flex; flex: 1 0 auto; flex-direction: column; min-height: 320px; padding: 12px 12px 10px; }\n.lf-category-head { display: flex; align-items: center; gap: 6px; min-height: 26px; margin-bottom: 6px; }\n.lf-label { margin: 0; color: #64748b; font-size: 12px; font-weight: 600; letter-spacing: .02em; }\n.lf-category-head small { color: #94a3b8; font-size: 12px; font-variant-numeric: tabular-nums; }\n.lf-category-head .lf-icon-button { margin-left: auto; }\n.lf-category-busy { margin: 0 6px 0 auto; color: #94a3b8; }\n\n.lf-current {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  margin-bottom: 8px;\n  padding: 4px 5px 4px 10px;\n  border: 1px solid #cfe0ff;\n  border-radius: 9px;\n  background: #f4f8ff;\n  color: var(--primary);\n}\n.lf-current > svg { flex-shrink: 0; }\n.lf-current-text { display: flex; flex: 1; flex-direction: column; min-width: 0; line-height: 1.4; }\n.lf-current-text strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 700; }\n.lf-current-text small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7b8899; font-size: 12px; }\n\n.lf-recent { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-bottom: 8px; color: #a3afbf; }\n.lf-recent-chip {\n  max-width: 124px;\n  height: 24px;\n  padding: 0 9px;\n  overflow: hidden;\n  border: 1px solid #e3e8f0;\n  border-radius: 999px;\n  background: #f8fafc;\n  color: #475569;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.lf-recent-chip:hover { border-color: #c4d3ea; background: #f4f8ff; color: var(--primary); }\n\n.lf-tree-options { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 8px; color: #64748b; font-size: 12px; }\n.lf-tree-options label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }\n.lf-tree-options input { width: 14px; height: 14px; margin: 0; accent-color: var(--primary); }\n.lf-tree-options label:has(input:disabled) { color: #a5afbd; cursor: default; }\n.lf-option-count { padding: 0 5px; border-radius: 999px; background: #f1f3f6; color: #7b8899; font-size: 11px; line-height: 16px; font-variant-numeric: tabular-nums; }\n\n/* The virtual tree: rows are absolutely placed in a box as tall as all of them */\n.lf-tree {\n  position: relative;\n  flex: 1 1 0;\n  min-height: 200px;\n  margin-top: 8px;\n  overflow: auto;\n  overscroll-behavior: contain;\n  border: 1px solid #e6ebf2;\n  border-radius: 9px;\n  background: #fcfdff;\n  scrollbar-width: thin;\n  scrollbar-color: #d5dde8 transparent;\n}\n.mg-page .lf-tree:focus-visible { outline: 2px solid #85a8e2; outline-offset: 1px; }\n.lf-tree-inner { position: relative; }\n.lf-node {\n  position: absolute;\n  left: 0;\n  right: 0;\n  display: flex;\n  align-items: center;\n  gap: 3px;\n  height: 30px;\n  padding-right: 8px;\n  color: #223046;\n  font-size: 13px;\n  white-space: nowrap;\n  cursor: pointer;\n  user-select: none;\n}\n.lf-node:hover { background: #f2f6fc; }\n.lf-node[aria-selected=\"true\"] { background: #e6effd; color: var(--primary); font-weight: 600; }\n.lf-node[aria-selected=\"true\"]::before { content: ''; position: absolute; left: 0; top: 5px; bottom: 5px; width: 3px; border-radius: 0 3px 3px 0; background: var(--primary); }\n.lf-tree:focus-visible .lf-node.is-active { box-shadow: inset 0 0 0 2px #9ab4dc; }\n.lf-node.is-context .lf-node-label { color: #8a96a8; }\n.lf-twisty { display: grid; place-items: center; flex-shrink: 0; width: 20px; height: 22px; border-radius: 5px; color: #94a3b8; }\n.lf-twisty svg { transition: transform .12s; }\n.lf-twisty.is-open svg { transform: rotate(90deg); }\n.lf-twisty.is-toggle:hover { color: #334155; background: rgba(15, 23, 42, .06); }\n.lf-node-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }\n.lf-node-label mark { padding: 0 1px; border-radius: 3px; background: #fff0b3; color: inherit; }\n.lf-off { flex-shrink: 0; padding: 0 5px; border-radius: 999px; background: #f1f3f6; color: #94a3b8; font-size: 11px; font-weight: 400; line-height: 17px; }\n.lf-node-count { flex-shrink: 0; min-width: 22px; color: #7b8899; font-size: 12px; font-weight: 400; text-align: right; font-variant-numeric: tabular-nums; }\n.lf-node-count.is-zero { color: #c3ccd8; }\n\n.lf-tree-status {\n  display: flex;\n  flex: 1;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  min-height: 120px;\n  margin: 8px 0 0;\n  padding: 16px;\n  border: 1px dashed #e1e7ef;\n  border-radius: 9px;\n  color: #7b8899;\n  font-size: 13px;\n  line-height: 1.7;\n  text-align: center;\n}\n.lf-tree-foot { margin: 7px 0 0; color: #94a3b8; font-size: 12px; line-height: 1.6; }\n.lf-tree-foot .mg-text-button, .lf-error .mg-text-button { padding: 0; font-size: 12px; }\n.lf-error { margin: 8px 0 0; color: #b42318; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }\n\n/* Narrow screens: the column sits above the images and folds away behind its header */\n@media (max-width: 900px) {\n  .lf-panel { overflow: visible; }\n  .lf-head { position: static; border-radius: 12px 12px 0 0; }\n  .lf-toggle {\n    display: inline-flex;\n    align-items: center;\n    gap: 3px;\n    margin-left: 2px;\n    padding: 4px 8px;\n    border: 1px solid #dfe5ee;\n    border-radius: 8px;\n    background: #fff;\n    color: #475569;\n    font-size: 13px;\n  }\n  .lf-toggle svg { transition: transform .15s; }\n  .lf-panel.is-open .lf-toggle svg { transform: rotate(180deg); }\n  .lf-panel:not(.is-open) .lf-body { display: none; }\n  .lf-panel:not(.is-open) .lf-head { border-bottom: 0; }\n  .lf-category { min-height: 0; }\n  .lf-tree { flex: none; height: clamp(62px, var(--lf-rows-height, 320px), 320px); min-height: 0; }\n}\n"],["STYLE",{},"/* 图片数据 · batch edit and batch delete dialogs */\n.lb-dialog { display: flex; flex-direction: column; gap: 14px; padding: 14px 16px 16px; background: #fff; }\n\n/* The selected images */\n.lb-strip { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }\n.lb-strip li { display: grid; place-items: center; width: 40px; height: 40px; overflow: hidden; border: 1px solid #e3e8f0; border-radius: 7px; background: #f2f4f8; color: #94a3b8; }\n.lb-strip img { width: 100%; height: 100%; object-fit: cover; }\n.lb-strip .lb-strip-more { width: auto; min-width: 40px; padding: 0 8px; color: #64748b; font-size: 12px; font-variant-numeric: tabular-nums; }\n\n/* The form: field · how it changes · new value */\n.lb-form { display: flex; flex-direction: column; }\n.lb-intro { margin: 0 0 4px; color: #64748b; font-size: 13px; line-height: 1.7; }\n.lb-form h3 { margin: 14px 0 4px; padding-top: 12px; border-top: 1px solid #eef1f6; color: #1f2a3a; font-size: 14px; font-weight: 800; }\n.lb-form h3:first-of-type { margin-top: 6px; padding-top: 0; border-top: 0; }\n.lb-row { display: grid; grid-template-columns: 76px 136px minmax(0, 1fr); align-items: start; gap: 6px 10px; padding: 6px 0; }\n.lb-row-label { padding-top: 8px; color: #475569; font-size: 14px; }\n.lb-mode, .lb-input {\n  box-sizing: border-box;\n  width: 100%;\n  min-height: 36px;\n  padding: 6px 10px;\n  border: 1px solid #d7e0ee;\n  border-radius: 9px;\n  background: #fff;\n  color: #223046;\n  font: inherit;\n  font-size: 14px;\n}\n.lb-mode { color: #64748b; }\n.lb-mode.is-set { border-color: #b7cdf3; background: #f4f8ff; color: var(--primary); font-weight: 600; }\ntextarea.lb-input { min-height: 72px; resize: vertical; line-height: 1.6; }\n.lb-unit { display: flex; align-items: center; gap: 6px; max-width: 220px; color: #64748b; font-size: 13px; }\n.lb-row-value { min-width: 0; }\n.lb-row-value .cp { margin-top: 0; }\n/* The row names the field; the picker's own label stays for assistive technology only */\n.lb-row-value .cp-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n.lb-row-value .cp-selected, .lb-row-value .cp-combo { margin-top: 0; }\n.lb-row-value .cp-selected + .cp-search .cp-combo { margin-top: 6px; }\n.lb-error { margin: 5px 0 0; color: #b42318; font-size: 12px; line-height: 1.6; }\n.lb-hint { margin: 5px 0 0; color: #7b8899; font-size: 12px; line-height: 1.6; }\n\n/* Progress and results */\n.lb-progress { display: flex; flex-direction: column; gap: 8px; }\n.lb-progress-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.lb-progress-head strong { display: inline-flex; align-items: center; gap: 6px; color: #1f2a3a; font-size: 14px; }\n.lb-progress-head > span { color: #64748b; font-size: 13px; font-variant-numeric: tabular-nums; }\n.lb-progress progress { width: 100%; height: 6px; appearance: none; border: 0; border-radius: 99px; overflow: hidden; background: #e9edf3; accent-color: var(--primary); }\n.lb-progress progress::-webkit-progress-bar { background: #e9edf3; border-radius: 99px; }\n.lb-progress progress::-webkit-progress-value { background: var(--primary); border-radius: 99px; }\n.lb-progress progress::-moz-progress-bar { background: var(--primary); border-radius: 99px; }\n.lb-tally { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; color: #64748b; font-size: 13px; font-variant-numeric: tabular-nums; }\n.lb-tally .is-done { color: #2f7d4a; }\n.lb-tally .is-skipped { color: #9a6700; }\n.lb-tally .is-failed { color: #b42318; font-weight: 600; }\n.lb-results { display: flex; flex-direction: column; max-height: 260px; margin: 0; padding: 0; overflow: auto; list-style: none; border: 1px solid #eef1f6; border-radius: 10px; }\n.lb-results li { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-bottom: 1px solid #f1f4f8; }\n.lb-results li:last-child { border-bottom: 0; }\n.lb-results img, .lb-thumb-empty { flex-shrink: 0; width: 34px; height: 34px; border-radius: 6px; object-fit: cover; background: #f2f4f8; }\n.lb-thumb-empty { display: grid; place-items: center; color: #94a3b8; }\n.lb-results li > span { display: flex; flex-direction: column; min-width: 0; }\n.lb-results strong { overflow: hidden; color: #223046; font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }\n.lb-results small { color: #64748b; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }\n.lb-results li.is-failed small { color: #b42318; }\n.lb-results li.is-skipped small { color: #9a6700; }\n\n/* Delete confirmation */\n.lb-confirm p { margin: 0; color: #3b4656; font-size: 14px; line-height: 1.8; }\n.lb-confirm strong { color: #161a1d; }\n.lb-confirm p.lb-note { margin-top: 8px; color: #64748b; font-size: 13px; line-height: 1.6; }\n.lb-type-confirm { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; color: #64748b; font-size: 13px; }\n.lb-type-confirm .lb-input { max-width: 200px; }\n\n.lb-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding: 10px 14px; border-top: 1px solid rgba(148, 163, 184, .22); background: rgba(252, 253, 255, .96); }\n.lb-summary { flex: 1; min-width: 200px; margin: 0; color: #64748b; font-size: 13px; line-height: 1.6; }\n.lb-summary strong { color: #161a1d; }\n.mg-btn.lb-danger { border-color: #f1c4be; background: #fdf0ee; color: #b42318; }\n.mg-btn.lb-danger:hover:not(:disabled) { border-color: #e9a59c; background: #fbe4e0; }\n\n@media (max-width: 580px) {\n  .lb-dialog { padding: 12px; }\n  .lb-row { grid-template-columns: 1fr; gap: 6px; }\n  .lb-row-label { padding-top: 0; font-weight: 600; }\n  .lb-summary { min-width: 100%; }\n}\n"],["STYLE",{},"/*\r\n * 图片数据: tools on the left (narrow), images on the right (wide). On wide screens each side\r\n * scrolls on its own and the images' header and pager stay in view; narrow screens stack them.\r\n */\r\n.library-page { display: flex; flex-direction: column; overflow: hidden; }\r\n.mg-page.mg-page-library { display: flex; flex: 1; flex-direction: column; min-height: 0; padding: 0; }\r\n.lib-layout { display: grid; flex: 1; min-height: 0; grid-template-columns: 300px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); gap: 12px; }\r\n\r\n.lib-main {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  background: #fff;\r\n  border: 1px solid rgba(148, 163, 184, .25);\r\n  border-radius: 12px;\r\n}\r\n\r\n.lib-head {\r\n  display: flex;\r\n  flex-shrink: 0;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 12px;\r\n  min-height: 46px;\r\n  padding: 5px 10px 5px 14px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.lib-head-title { display: flex; align-items: center; gap: 8px; min-width: 0; }\r\n.lib-head-title h2 { font-size: 14px; font-weight: 700; color: #334155; white-space: nowrap; }\r\n.lib-count { padding: 1px 7px; border-radius: 4px; background: #eef3fa; color: #5f7ba5; font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; }\r\n.lib-busy { flex-shrink: 0; color: #94a3b8; }\r\n.mg-status.lib-status { margin-left: 4px; padding: 3px 8px; font-size: 12px; }\r\n.lib-status.is-error > span { background: #c5a16b; }\r\n.lib-head-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; margin-left: auto; }\r\n.lib-page-size { display: inline-flex; align-items: center; gap: 6px; color: #64748b; font-size: 13px; white-space: nowrap; }\r\n.lib-page-size .mg-select { min-width: 0; height: 34px; padding-right: 24px; }\r\n.lib-head-tools .mg-view-toggle button { width: 32px; height: 30px; }\r\n.lib-head-tools .mg-btn { height: 34px; }\r\n\r\n/* What narrows the list, each removable */\r\n.lib-chips { display: flex; flex-shrink: 0; flex-wrap: wrap; align-items: center; gap: 6px; padding: 7px 14px; border-bottom: 1px solid var(--border); background: #f8faff; }\r\n.lib-chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  max-width: 100%;\r\n  height: 26px;\r\n  padding: 0 3px 0 9px;\r\n  border: 1px solid #d6e3fa;\r\n  border-radius: 999px;\r\n  background: #fff;\r\n  font-size: 12px;\r\n}\r\n.lib-chip > small { flex-shrink: 0; color: #7b8899; font-size: 12px; }\r\n.lib-chip-value { min-width: 0; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--primary); font-weight: 600; }\r\n.lib-chip > button { display: grid; place-items: center; flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; color: #7b8899; }\r\n.lib-chip > button:hover { color: #b42318; background: #fdf0ee; }\r\n.lib-chips > .mg-text-button { margin-left: 4px; font-size: 12px; }\r\n\r\n/* Picking images for a batch action */\r\n.lib-selection { display: flex; flex-shrink: 0; flex-wrap: wrap; align-items: center; gap: 6px 14px; min-height: 46px; padding: 6px 12px 6px 14px; border-bottom: 1px solid var(--border); background: #fcfdff; font-size: 13px; }\r\n.lib-select-page { display: inline-flex; align-items: center; gap: 7px; color: #334155; cursor: pointer; user-select: none; }\r\n.lib-select-page input, .lib-card-check input, .lib-row-check input { width: 16px; height: 16px; margin: 0; accent-color: var(--primary); cursor: pointer; }\r\n.lib-selection .mg-text-button { gap: 5px; font-size: 13px; }\r\n.lib-selection .mg-text-button:disabled { color: var(--muted); cursor: default; text-decoration: none; }\r\n.lib-selected-count { color: #64748b; font-variant-numeric: tabular-nums; }\r\n.lib-selection-actions { display: flex; gap: 8px; margin-left: auto; }\r\n.lib-selection-actions .mg-btn { height: 32px; padding: 0 12px; font-size: 13px; }\r\n\r\n.lib-card-check {\r\n  position: absolute;\r\n  top: 8px;\r\n  left: 8px;\r\n  z-index: 2;\r\n  display: grid;\r\n  place-items: center;\r\n  width: 28px;\r\n  height: 28px;\r\n  border: 1px solid rgba(223, 229, 238, .95);\r\n  border-radius: 8px;\r\n  background: rgba(255, 255, 255, .94);\r\n  box-shadow: 0 2px 6px rgba(15, 23, 42, .08);\r\n  cursor: pointer;\r\n}\r\n.mg-library-card.is-selected { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(44, 86, 160, .32); }\r\n.mg-library-card.is-selected .lib-card-check { border-color: #b7cdf3; background: #edf3fc; }\r\n.lib-row-check { display: grid; place-items: center; cursor: pointer; }\r\n.lib-content .mg-library-row, .lib-content .mg-library-head { grid-template-columns: 22px 2fr 1fr 1fr 1fr; }\r\n.lib-content .mg-library-row.is-selected { background: #eef4fd; }\r\n\r\n.lib-content { position: relative; flex: 1; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable; }\r\n.lib-content > .mg-errors { margin-top: 14px; }\r\n.lib-content > .mg-empty { justify-content: center; min-height: 100%; }\r\n\r\n/* Cards: large shows scenes and tags, small only the image, title and state */\r\n.mg-library-grid.lib-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));\r\n  gap: 12px;\r\n  padding: 14px;\r\n}\r\n.mg-library-grid.lib-grid.is-small { grid-template-columns: repeat(auto-fill, minmax(min(100%, 130px), 1fr)); gap: 10px; }\r\n.lib-grid.is-small .mg-upload-card > div { padding: 7px 8px 8px; }\r\n.lib-grid.is-small .mg-upload-card strong { font-size: 12px; }\r\n.lib-grid.is-small .mg-upload-card small { gap: 3px; margin-top: 5px; }\r\n.lib-grid.is-small .mg-category-chip { padding: 1px 6px; font-size: 12px; }\r\n.lib-grid.is-small .mg-upload-preview > span { display: none; }\r\n\r\n/* A card's category and tags filter by themselves */\r\n.mg-category-chip.lib-filter-chip { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; transition: border-color .12s, background .12s, color .12s; }\r\n.mg-category-chip.lib-filter-chip:hover { border-color: #b7cdf3; background: #f4f8ff; color: var(--primary); }\r\n.mg-category-chip.is-current { max-width: 100%; overflow: hidden; border-color: #b7cdf3; background: #edf3fc; color: var(--primary); text-overflow: ellipsis; white-space: nowrap; }\r\n.lib-tag { padding: 0; color: #64748b; font-size: 11px; cursor: pointer; }\r\n.lib-tag:hover { color: var(--primary); text-decoration: underline; }\r\n.lib-tag.is-current { color: var(--primary); font-weight: 600; cursor: default; text-decoration: none; }\r\n.lib-tag-more { color: #94a3b8; cursor: help; }\r\n.mg-attributes .lib-tag, .mg-attributes .lib-tag-more { margin-right: 6px; font-size: 13px; }\r\n.lib-none { color: #94a3b8; }\r\n\r\n/* Rows: the head stays on top of the scrolled list */\r\n.lib-content .mg-library-head { position: sticky; top: 0; z-index: 1; border-top: 0; }\r\n.lib-row-category { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; }\r\n.lib-row-category small { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; font-size: 12px; }\r\n.lib-row-time { color: #64748b; font-variant-numeric: tabular-nums; }\r\n\r\n.lib-loading > p { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 16px 0 0; color: #7b8899; font-size: 13px; }\r\n.lib-skeleton > span {\r\n  display: block;\r\n  aspect-ratio: 1 / 1.22;\r\n  border-radius: 10px;\r\n  background: linear-gradient(110deg, #f2f5f9 30%, #fafcfe 50%, #f2f5f9 70%);\r\n  background-size: 200% 100%;\r\n  animation: shimmer 1.5s infinite;\r\n}\r\n\r\n.mg-pagination.lib-pagination { flex-shrink: 0; flex-wrap: wrap; gap: 8px 12px; padding: 8px 12px 8px 14px; }\r\n.lib-page-summary { min-width: 0; font-variant-numeric: tabular-nums; }\r\n.lib-pager { display: flex; align-items: center; gap: 6px; }\r\n.lib-pager button { width: 28px; height: 28px; }\r\n.lib-pager button:not(:disabled):hover { border-color: #c4d3ea; color: var(--primary); }\r\n.lib-page-jump { display: inline-flex; align-items: center; gap: 5px; color: #64748b; font-size: 13px; white-space: nowrap; }\r\n.lib-page-jump input {\r\n  width: 56px;\r\n  height: 28px;\r\n  padding: 0 6px;\r\n  border: 1px solid #d7e0ee;\r\n  border-radius: 6px;\r\n  background: #fff;\r\n  color: #223046;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  text-align: center;\r\n  font-variant-numeric: tabular-nums;\r\n  -moz-appearance: textfield;\r\n  appearance: textfield;\r\n}\r\n.lib-page-jump input::-webkit-inner-spin-button,\r\n.lib-page-jump input::-webkit-outer-spin-button { margin: 0; -webkit-appearance: none; appearance: none; }\r\n\r\n@media (min-width: 1500px) {\r\n  .lib-layout { grid-template-columns: 320px minmax(0, 1fr); }\r\n}\r\n\r\n@media (max-width: 1100px) {\r\n  .lib-layout { grid-template-columns: 270px minmax(0, 1fr); gap: 10px; }\r\n  .mg-status.lib-status { display: none; }\r\n}\r\n\r\n/* Rows on narrow screens: the checkbox, the name and the category (the first column moved the others) */\r\n@media (max-width: 860px) {\r\n  .lib-content .mg-library-row, .lib-content .mg-library-head { grid-template-columns: 22px 1.4fr .8fr; gap: 10px; }\r\n  .lib-content .mg-library-row > span:nth-child(3) { display: flex; }\r\n  .lib-content .mg-library-row > span:nth-child(4), .lib-content .mg-library-row > span:nth-child(5),\r\n  .lib-content .mg-library-head > span:nth-child(4), .lib-content .mg-library-head > span:nth-child(5) { display: none; }\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .library-page { overflow: auto; }\r\n  .mg-page.mg-page-library { display: block; flex: none; }\r\n  .lib-layout { display: flex; flex-direction: column; gap: 10px; }\r\n  .lib-main { overflow: visible; }\r\n  .lib-content { flex: none; overflow: visible; }\r\n  .lib-content > .mg-empty { min-height: 0; }\r\n}\r\n\r\n@media (max-width: 580px) {\r\n  .lib-head { padding: 6px 10px; }\r\n  .lib-head-tools { justify-content: space-between; width: 100%; }\r\n  .lib-page-size > span { display: none; }\r\n  .mg-library-grid.lib-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 10px; padding: 10px; }\r\n  .mg-library-grid.lib-grid.is-small { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }\r\n  .lib-chips { padding: 7px 10px; }\r\n  .lib-selection { padding: 6px 10px; }\r\n  .lib-selection-actions { width: 100%; margin-left: 0; }\r\n  .lib-selection-actions .mg-btn { flex: 1; }\r\n  .lib-chip-value { max-width: 180px; }\r\n  .mg-pagination.lib-pagination { justify-content: center; padding: 8px 10px; }\r\n  .lib-page-summary { width: 100%; text-align: center; }\r\n}\r\n"],["STYLE",{},"/* Upload-only parts of the annotation form: scene choices and the single-image dialog.\n   Shared field styles are in features/annotation-fields/annotation-fields.css. */\n.ia-scenes { margin: 14px 0 0; padding: 0; border: 0; min-width: 0; }\n.ia-scenes legend { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; padding: 0; color: #7b8899; font-size: 13px; }\n.ia-badge { padding: 0 7px; border-radius: 999px; background: #fff4e5; color: #9a6700; font-size: 11px; line-height: 18px; }\n.ia-scene-list { display: flex; flex-direction: column; gap: 4px; margin: 0; padding: 0; list-style: none; }\n.ia-scene { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 8px; padding: 6px 9px; border: 1px solid #e8edf5; border-radius: 8px; background: #fff; cursor: pointer; transition: border-color .12s, background .12s; }\n.ia-scene:hover { border-color: #cfdbee; }\n.ia-scene.is-member { border-color: #cfe0ff; background: #f6f9ff; }\n.ia-scene.is-locked { cursor: default; }\n.ia-scene input { margin: 0; accent-color: var(--primary); }\n.ia-scene-name { min-width: 0; color: #223046; font-size: 14px; overflow-wrap: anywhere; }\n.ia-scene-name code { margin-left: 6px; color: #94a3b8; }\n.ia-scene-source { padding: 0 7px; border-radius: 999px; font-size: 11px; line-height: 18px; white-space: nowrap; }\n.ia-scene-source.is-all { background: #eef2f7; color: #64748b; }\n.ia-scene-source.is-rule { background: #eaf5ee; color: #2f7d4a; }\n.ia-scene-source.is-manual { background: #fff4e5; color: #9a6700; }\n.ia-scene-source.is-none { color: #94a3b8; }\n.ia-scenes:disabled .ia-scene { cursor: not-allowed; opacity: .7; }\n\n/* Single-image dialog: preview beside the form; stacked on narrow screens */\n.ia-single { display: grid; grid-template-columns: 200px minmax(0, 1fr); align-items: start; gap: 14px; padding: 12px; }\n.ia-single-preview { position: sticky; top: 0; display: flex; flex-direction: column; gap: 6px; }\n.ia-single-preview img { width: 100%; aspect-ratio: 1; object-fit: cover; border: 1px solid #e5e9f0; border-radius: 8px; background: #f2f4f8; }\n.ia-single-preview small { display: block; color: #64748b; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }\n.ia-single-preview small + small { margin-top: 4px; }\n.ia-dialog-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; padding: 10px 12px; border-top: 1px solid rgba(148, 163, 184, .22); background: rgba(252, 253, 255, .92); }\n.ia-dialog-actions .ia-dialog-reset { margin-right: auto; }\n\n@media (max-width: 640px) {\n  .ia-single { grid-template-columns: 1fr; }\n  .ia-single-preview { position: static; flex-direction: row; align-items: center; }\n  .ia-single-preview img { width: 72px; }\n}\n"],["STYLE",{},".mg-page {\r\n  width: 100%;\r\n  min-width: 0;\r\n  color: var(--text);\r\n  font-size: 15px;\r\n  padding: 0 0 24px;\r\n}\r\n\r\n.mg-page-toolbar {\r\n  position: relative;  /* narrow screens: the category filter popover spans the toolbar */\r\n  z-index: 3;\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.mg-toolbar-summary { font-size: 12px; color: var(--muted); line-height: 1.6; }\r\n\r\n.mg-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 5px 9px;\r\n  background: var(--panel-bg);\r\n  color: var(--muted);\r\n  font-size: 13px;\r\n  white-space: nowrap;\r\n  margin-left: auto;\r\n}\r\n\r\n.mg-status > span {\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: #94a3b8;\r\n}\r\n\r\n.mg-metrics {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.mg-metric {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 14px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--panel-bg);\r\n}\r\n\r\n.mg-metric > div {\r\n  display: grid;\r\n  grid-template-columns: auto auto;\r\n  align-items: center;\r\n  gap: 5px 14px;\r\n}\r\n\r\n.mg-metric > div > span { font-size: 14px; color: var(--muted); }\r\n.mg-metric strong { font-size: 20px; line-height: 1.1; font-weight: 700; color: var(--text); }\r\n.mg-metric small { grid-column: 1 / -1; font-size: 12px; color: var(--muted); }\r\n.mg-metric-icon { display: grid; place-items: center; color: #7b8899; }\r\n.mg-metric-icon svg { width: 20px; height: 20px; }\r\n\r\n.mg-panel {\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--panel-bg);\r\n  overflow: hidden;\r\n}\r\n\r\n.mg-import-settings h2 { margin: 0; font-size: 16px; font-weight: 700; }\r\n.mg-import-settings > p { margin: 5px 0 0; font-size: 13px; color: var(--muted); line-height: 1.7; }\r\n\r\n.mg-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  border: 1px solid transparent;\r\n  border-radius: 10px;\r\n  height: 38px;\r\n  padding: 0 14px;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  letter-spacing: .01em;\r\n  line-height: 1;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition: background .12s, border-color .12s, transform .08s, color .12s;\r\n}\r\n\r\n.mg-btn:active:not(:disabled) { transform: translateY(1px); }\r\n.mg-primary { color: #1d4ed8; background: #eaf2ff; border-color: #cfe0ff; }\r\n.mg-primary:hover:not(:disabled) { background: #deebff; border-color: #b7d1ff; }\r\n.mg-secondary { color: #334155; background: #f2f6ff; border-color: #d7e2ff; }\r\n.mg-secondary:hover:not(:disabled) { background: #e9efff; border-color: #c2d2ff; }\r\n.mg-btn:disabled { opacity: .6; cursor: not-allowed; filter: saturate(.85); }\r\n\r\n.mg-search {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  flex: 1;\r\n  min-width: 200px;\r\n  max-width: 380px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  height: 38px;\r\n  padding: 0 10px;\r\n  color: var(--muted);\r\n  background: #fff;\r\n}\r\n\r\n.mg-search input {\r\n  width: 100%;\r\n  min-width: 0;\r\n  padding: 0;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n  background: transparent;\r\n  border: 0;\r\n  outline: 0;\r\n}\r\n\r\n.mg-search input::placeholder { color: #7b8aa0; }\r\n.mg-search:focus-within { border-color: #9ab4dc; box-shadow: 0 0 0 3px rgba(59, 130, 246, .1); }\r\n.mg-page .mg-search input:focus-visible { outline: 0; }  /* the box above shows the focus */\r\n.mg-search button { display: grid; place-items: center; padding: 0; border: 0; background: none; color: var(--muted); cursor: pointer; }\r\n\r\n.mg-select {\r\n  min-width: 130px;\r\n  height: 38px;\r\n  padding: 0 28px 0 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: #fff;\r\n  color: #334155;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n  line-height: 1.4;\r\n}\r\n\r\n/* A filter that narrows the list: the same look as the category filter's chosen state */\r\n.mg-select.is-set { border-color: #cfe0ff; background: #f4f8ff; color: var(--primary); }\r\n\r\n.mg-view-toggle { display: flex; gap: 1px; padding: 2px; border: 1px solid var(--border); border-radius: 10px; }\r\n.mg-view-toggle button { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 0; border-radius: 7px; color: #6b7280; background: transparent; cursor: pointer; }\r\n.mg-view-toggle button.active { color: var(--primary); background: #edf3fc; }\r\n\r\n.mg-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 40px 24px 44px; }\r\n.mg-empty-icon { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 14px; color: #94a3b8; }\r\n.mg-empty h3 { margin: 0 0 8px; font-size: 16px; font-weight: 500; color: #334155; }\r\n.mg-empty p { max-width: 410px; margin: 0 0 18px; font-size: 13px; line-height: 1.9; color: var(--muted); }\r\n\r\n.mg-pagination { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 18px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; background: #fafbfc; }\r\n.mg-pagination > div { display: flex; align-items: center; gap: 12px; }\r\n.mg-pagination button { display: grid; place-items: center; border: 1px solid var(--border); border-radius: 4px; background: #fff; padding: 4px; color: #6b7280; }\r\n.mg-pagination button:disabled { opacity: .55; }\r\n.mg-info { display: flex; align-items: flex-start; gap: 7px; margin-top: 12px; padding: 0 2px; color: #6b7280; font-size: 13px; line-height: 1.8; }\r\n.mg-info svg { flex-shrink: 0; width: 14px; height: 14px; margin-top: 3px; }\r\n.mg-info p { margin: 0; }\r\n\r\n.mg-table-head { display: grid; align-items: center; gap: 18px; padding: 11px 18px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); color: #334155; background: #f6f7f8; font-size: 14px; font-weight: 700; }\r\n.mg-library-head { grid-template-columns: 2fr 1fr 1fr 1fr; }\r\n.mg-task-head { grid-template-columns: 1.5fr 1.2fr .7fr 1fr; }\r\n\r\n.mg-import-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; align-items: start; gap: 14px; }\r\n.mg-import-main { min-width: 0; }\r\n.mg-dropzone { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 16px 18px; padding: 18px 20px; border: 1px dashed #cbd5e1; border-radius: 10px; background: #fafbfc; transition: background .15s, border-color .15s; }\r\n.mg-dropzone.is-dragging { background: #edf4ff; border-color: var(--primary); }\r\n.mg-drop-icon { display: grid; place-items: center; width: 40px; height: 40px; flex-shrink: 0; color: #7b8899; }\r\n.mg-dropzone h3 { margin: 0 0 5px; font-size: 15px; font-weight: 500; }\r\n.mg-dropzone p { font-size: 13px; color: var(--muted); margin: 0; }\r\n.mg-hidden { display: none; }\r\n.mg-queue-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 18px 15px; padding-top: 16px; border-top: 1px solid var(--border); }\r\n.mg-queue-heading h3 { margin: 0; font-size: 16px; font-weight: 500; }\r\n.mg-queue-heading h3 span { margin-left: 6px; padding: 2px 6px; color: #475569; background: #edf2f9; border-radius: 3px; font-size: 12px; }\r\n.mg-text-button { display: inline-flex; align-items: center; gap: 6px; padding: 3px 0; border: 0; background: none; color: var(--primary); font-family: inherit; font-size: 13px; cursor: pointer; }\r\n.mg-text-button:hover { text-decoration: underline; }\r\n.mg-queue-empty { display: flex; flex-direction: column; align-items: center; color: #94a3b8; padding: 18px 10px 30px; }\r\n.mg-queue-empty p { font-size: 13px; margin-bottom: 0; }\r\n\r\n.mg-upload-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 14px; padding: 0 18px 18px; }\r\n.mg-upload-card { min-width: 0; position: relative; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }\r\n.mg-upload-preview { display: block; position: relative; overflow: hidden; width: 100%; padding: 0; aspect-ratio: 1; border: 0; background: #f2f4f8; cursor: pointer; }\r\n.mg-upload-preview img { width: 100%; height: 100%; object-fit: cover; transition: transform .2s; }\r\n.mg-upload-preview:hover img { transform: scale(1.03); }\r\n.mg-upload-preview > span { position: absolute; inset: auto 0 0; padding: 13px 8px 7px; color: #fff; background: linear-gradient(transparent, #26344b9e); font-family: inherit; font-size: 12px; text-align: left; opacity: 0; transition: opacity .15s; }\r\n.mg-upload-preview:hover > span,\r\n.mg-upload-preview:focus-visible > span { opacity: 1; }\r\n.mg-remove-image { display: grid; place-items: center; position: absolute; right: 5px; top: 5px; width: 24px; height: 24px; border: 1px solid #ffffffb0; border-radius: 4px; background: #fffffff0; color: #64748b; cursor: pointer; }\r\n.mg-upload-card > div { padding: 9px; }\r\n.mg-upload-card strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 500; }\r\n.mg-upload-card small { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px; margin-top: 6px; color: #6b7280; font-size: 12px; }\r\n.mg-upload-card small > span { color: #64748b; }\r\n\r\n.mg-errors { margin: 0 18px 16px; padding: 11px 12px; border: 1px solid #e9d6bd; border-radius: 5px; color: #956d3f; background: #fffcf7; font-size: 13px; }\r\n.mg-errors > div { display: flex; justify-content: space-between; gap: 12px; }\r\n.mg-errors strong { font-weight: 500; }\r\n.mg-errors button { display: grid; place-items: center; background: none; border: 0; color: inherit; cursor: pointer; }\r\n.mg-errors ul { max-height: 150px; overflow: auto; overflow-wrap: anywhere; padding-left: 17px; margin: 7px 0 0; line-height: 1.8; }\r\n\r\n.mg-import-settings { padding: 18px; overflow: visible; }  /* visible: the run bar sticks to the screen, not to the panel */\r\n.mg-import-settings > .ia-form { margin-top: 14px; }\r\n.mg-import-run { position: sticky; bottom: 0; z-index: 2; margin: 14px -18px -18px; padding: 12px 18px 16px; border-top: 1px solid var(--border); border-radius: 0 0 12px 12px; background: rgba(255, 255, 255, .97); box-shadow: 0 -6px 14px rgba(15, 23, 42, .04); }\r\n.mg-import-tally { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; margin: 0 0 8px; color: var(--muted); font-size: 13px; }\r\n.mg-import-tally strong { color: #223046; font-weight: 600; font-variant-numeric: tabular-nums; }\r\n.mg-import-run .mg-index-progress { margin-top: 0; }\r\n.mg-import-blockers { margin: 0 0 10px; padding: 8px 10px 8px 26px; border: 1px solid #e9d6bd; border-radius: 8px; background: #fffcf7; color: #956d3f; font-size: 12px; line-height: 1.7; }\r\n.mg-field { display: block; margin-top: 18px; font-size: 14px; color: #7b8899; line-height: 1.6; }\r\n.mg-field > .mg-select,\r\n.mg-field > input,\r\n.mg-field > select,\r\n.mg-field > textarea { display: block; box-sizing: border-box; width: 100%; margin-top: 7px; padding: 7px 10px; border: 1px solid #d7e0ee; border-radius: 10px; font-family: inherit; font-size: 14px; line-height: 1.6; background: #fff; color: #223046; font-weight: 600; }\r\n.mg-field > input,\r\n.mg-field > select { min-height: 38px; }\r\n.mg-field > textarea { resize: vertical; min-height: 84px; }\r\n.mg-field input::placeholder,\r\n.mg-field textarea::placeholder { color: #7b8aa0; }\r\n.mg-field > small { display: block; margin-top: 5px; font-size: 12px; color: #7b8899; }\r\n.mg-full { width: 100%; }\r\n.mg-help { margin-top: 12px !important; color: #6b7280 !important; font-size: 12px !important; line-height: 1.9 !important; }\r\n.mg-workflow-note { margin-top: 12px; padding: 17px 18px; border: 1px solid var(--border); border-radius: 12px; color: #7b8899; background: var(--panel-bg); }\r\n.mg-workflow-note h3 { margin: 9px 0 7px; color: #334155; font-size: 16px; font-weight: 500; }\r\n.mg-workflow-note p { margin: 0 0 10px; color: #6b7280; font-size: 13px; line-height: 1.9; }\r\n\r\n.mg-tabs { display: flex; gap: 25px; padding: 0 18px; border-top: 1px solid var(--border); overflow: auto; }\r\n.mg-tabs button { padding: 12px 0 10px; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); font-family: inherit; font-size: 14px; white-space: nowrap; cursor: pointer; }\r\n.mg-tabs button.active { border-bottom-color: var(--primary); color: var(--primary); }\r\n.mg-page-toolbar > .mg-tabs { border: 0; padding: 0; }\r\n.mg-table-row { padding: 11px 18px; border-bottom: 1px solid #edf0f5; font-size: 14px; }\r\n.mg-table-row:nth-child(odd) { background: #fafbfe; }\r\n.mg-table-row:hover { background: #f4f8fe; }\r\n.mg-table-row:last-child { border-bottom: 0; }\r\n.mg-category-chip { display: inline-block; padding: 3px 7px; border: 1px solid #e5eaf2; border-radius: 6px; background: #f6f7f8; color: #475569; font-size: 13px; }\r\n.mg-attributes { overflow-wrap: anywhere; color: #475569; font-size: 14px; }\r\n.mg-row-actions { display: flex; gap: 10px; }\r\n.mg-row-actions button { display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 0; border-radius: 8px; background: none; color: #64748b; cursor: pointer; }\r\n.mg-row-actions button:hover { color: var(--primary); background: rgba(15, 23, 42, .04); }\r\n.mg-row-actions button:last-child:hover { color: #bd6464; }\r\n\r\n/* Detail forms share the same quiet section structure as the result dialog. */\r\n.mg-editor { display: flex; flex-direction: column; min-height: 0; padding: 0; overflow: hidden; }\r\n.mg-editor-body { min-height: 0; padding: 8px; overflow: auto; background: #f6f8fb; }\r\n.mg-editor-note { display: flex; align-items: center; gap: 6px; padding: 0 4px; margin: 2px 0 12px; color: #7b8899; font-size: 13px; }\r\n.mg-editor-section { margin-top: 6px; padding: 12px 16px 16px; border: 1px solid #edf1f7; border-radius: 10px; background: #fcfdff; }\r\n.mg-editor-section h3 { margin: 0 0 14px; color: #1f2a3a; font-size: 16px; font-weight: 800; }\r\n.mg-editor .mg-field { display: grid; grid-template-columns: 90px minmax(0, 1fr); align-items: start; gap: 5px 12px; margin-top: 13px; }\r\n.mg-field-label { padding-top: 7px; font-size: 14px; color: #7b8899; }\r\n.mg-field-label > span { color: #c47b7b; }\r\n.mg-editor .mg-field > input,\r\n.mg-editor .mg-field > select,\r\n.mg-editor .mg-field > textarea { margin: 0; }\r\n.mg-editor .mg-field > small { grid-column: 2; margin-top: 0; line-height: 1.7; }\r\n.mg-editor-actions { display: flex; justify-content: flex-end; flex-shrink: 0; gap: 8px; margin: 0; padding: 10px 12px; border-top: 1px solid rgba(148, 163, 184, .22); background: rgba(252, 253, 255, .92); }\r\n.mg-form-error { margin: 12px 4px 0; color: #b16464; font-size: 13px; }\r\n.mg-dialog-image { display: block; width: calc(100% - 24px); max-height: 75vh; margin: 12px auto 0; object-fit: contain; border-radius: 4px; }\r\n.mg-preview-name { margin: 12px 16px 16px; color: var(--muted); font-size: 14px; overflow-wrap: anywhere; }\r\n.mg-page button:focus-visible,\r\n.mg-page select:focus-visible,\r\n.mg-page input:focus-visible,\r\n.mg-page textarea:focus-visible,\r\n.mg-editor input:focus-visible,\r\n.mg-editor select:focus-visible,\r\n.mg-editor textarea:focus-visible { outline: 2px solid #87a6d3; outline-offset: 2px; }\r\n\r\n@media (min-width: 1500px) {\r\n  .mg-import-layout { grid-template-columns: minmax(0, 1fr) 400px; }\r\n}\r\n\r\n@media (max-width: 1100px) {\r\n  .mg-import-layout { grid-template-columns: minmax(0, 1fr) 330px; gap: 12px; }\r\n}\r\n\r\n@media (max-width: 860px) {\r\n  .mg-import-layout { grid-template-columns: 1fr; }\r\n  .mg-import-aside { display: grid; grid-template-columns: 1fr; align-items: start; gap: 12px; }\r\n  .mg-workflow-note { margin-top: 0; }\r\n}\r\n\r\n@media (max-width: 800px) {\r\n  .mg-metric { padding: 13px; }\r\n  .mg-metric-icon { display: none; }\r\n}\r\n\r\n@media (max-width: 580px) {\r\n  .mg-btn { height: 34px; font-size: 14px; }\r\n  .mg-page-toolbar { gap: 8px; }\r\n  .mg-status { font-size: 12px; padding: 4px 6px; }\r\n  .mg-metrics { gap: 7px; }\r\n  .mg-metric { padding: 12px 10px; }\r\n  .mg-metric > div { grid-template-columns: 1fr; gap: 8px; }\r\n  .mg-metric > div > span { font-size: 12px; }\r\n  .mg-metric strong { font-size: 22px; }\r\n  .mg-metric small { font-size: 12px; line-height: 1.5; }\r\n  .mg-search { min-width: 100%; max-width: none; box-sizing: border-box; }\r\n  .mg-select { min-width: 120px; }\r\n  .mg-empty { padding: 32px 18px 36px; }\r\n  .mg-pagination { padding: 10px 14px; font-size: 12px; }\r\n  .mg-pagination > div { gap: 8px; }\r\n  .mg-pagination > div > span:first-child { display: none; }\r\n  .mg-import-aside { grid-template-columns: 1fr; }\r\n  .mg-dropzone { margin: 14px; padding: 16px 12px; gap: 8px; }\r\n  .mg-queue-heading { margin-left: 14px; margin-right: 14px; }\r\n  .mg-upload-grid { padding: 0 14px 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 10px; }\r\n  .mg-errors { margin-left: 14px; margin-right: 14px; }\r\n  .mg-table-head { padding: 10px 14px; font-size: 12px; }\r\n  .mg-library-head { gap: 8px; }\r\n  .mg-tabs { gap: 22px; padding: 0 14px; }\r\n  .mg-tabs button { font-size: 13px; }\r\n  .mg-task-head { grid-template-columns: 1.4fr 1fr .7fr; }\r\n  .mg-task-head > span:last-child { display: none; }\r\n  .mg-info { font-size: 12px; }\r\n  .mg-editor-section { padding: 12px; }\r\n  .mg-editor .mg-field { grid-template-columns: 1fr; gap: 7px; }\r\n  .mg-editor .mg-field > small { grid-column: 1; }\r\n  .mg-editor .mg-field-label { padding-top: 0; }\r\n  .mg-editor-actions .mg-btn { height: 34px; padding: 0 10px; font-size: 14px; }\r\n}\r\n\r\n\r\n/* === import page layout === */\r\n.mg-page.mg-page-import {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  min-height: 0;\r\n  height: 100%;\r\n  overflow: hidden;\r\n  padding: 0;\r\n}\r\n.mg-import-meta {\r\n  display: flex;\r\n  flex-shrink: 0;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px 12px;\r\n  margin-bottom: 10px;\r\n}\r\n.mg-import-meta .mg-status { margin-left: 0; }\r\n.mg-page-import .mg-import-layout {\r\n  flex: 1;\r\n  min-height: 0;\r\n  align-items: stretch;\r\n  grid-template-rows: minmax(0, 1fr);\r\n}\r\n.mg-page-import .mg-import-main {\r\n  min-height: 0;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n}\r\n.mg-pickup-row {\r\n  display: flex;\r\n  align-items: stretch;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin: 12px 18px 0;\r\n}\r\n.mg-pickup-row > .mg-btn,\r\n.mg-pickup-row > .mg-toolbar-summary { flex-shrink: 0; align-self: center; }\r\n.mg-pickup-row .mg-dropzone {\r\n  flex: 1 1 200px;\r\n  min-width: min(200px, 100%);\r\n  margin: 0;\r\n  padding: 6px 16px;\r\n  min-height: 48px;\r\n  max-height: 56px;\r\n  justify-content: flex-start;\r\n}\r\n.mg-pickup-row .mg-dropzone h3 { margin: 0; font-size: 14px; }\r\n.mg-pickup-row .mg-dropzone p { margin-top: 2px; font-size: 12px; }\r\n.mg-page-import .mg-import-aside {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  align-self: start;\r\n  position: sticky;\r\n  top: 0;\r\n  height: 100%;\r\n  max-height: calc(100dvh - var(--app-topbar-h) - 28px);\r\n}\r\n.mg-page-import .mg-import-settings {\r\n  display: flex;\r\n  flex: 1;\r\n  flex-direction: column;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n.mg-import-settings-head { flex-shrink: 0; }\r\n.mg-import-settings-head > p { margin: 5px 0 0; font-size: 13px; color: var(--muted); line-height: 1.7; }\r\n.mg-import-settings-body {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: auto;\r\n  overscroll-behavior: contain;\r\n}\r\n.mg-import-settings-body > .ia-form { margin-top: 14px; }\r\n.mg-page-import .mg-import-run {\r\n  position: static;\r\n  flex-shrink: 0;\r\n}\r\n.mg-page-import .mg-workflow-note { flex-shrink: 0; }\r\n\r\n@media (max-width: 860px) {\r\n  .mg-page-import .mg-import-layout {\r\n    grid-template-columns: 1fr;\r\n    grid-template-rows: minmax(0, 1fr) auto;\r\n  }\r\n  .mg-page-import .mg-import-aside {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    height: auto;\r\n    position: sticky;\r\n    top: auto;\r\n    bottom: 0;\r\n    z-index: 4;\r\n    max-height: min(52dvh, calc(100dvh - var(--app-topbar-h) - 28px - 7.5rem));\r\n    background: var(--canvas);\r\n    box-shadow: 0 -6px 14px rgba(15, 23, 42, .04);\r\n  }\r\n}\r\n\r\n@media (max-width: 580px) {\r\n  .mg-pickup-row { margin: 10px 14px 0; }\r\n  .mg-pickup-row .mg-dropzone { margin: 0; padding: 6px 12px; max-height: 56px; }\r\n}\r\n\r\n/* Narrow remaining main height (~ < 560px): 100dvh - topbar 56 - main padding 28 = 644 */\r\n@media (max-height: 644px) {\r\n  .mg-pickup-row { margin-top: 8px; }\r\n  .mg-pickup-row .mg-dropzone { min-height: 38px; max-height: 48px; padding-block: 4px; }\r\n  .mg-pickup-row .mg-dropzone p { display: none; }\r\n  .mg-page-import .mg-workflow-note { padding: 10px 12px; }\r\n  .mg-page-import .mg-workflow-note h3 { margin: 6px 0 4px; }\r\n  .mg-page-import .mg-workflow-note p { margin-bottom: 6px; }\r\n}\r\n\r\n/* === index-search-mvp import progress === */\r\n.mg-dropzone.is-disabled { opacity: 0.65; pointer-events: none; }\r\n.mg-index-progress {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  gap: 7px;\r\n  border: 1px solid #e4e9f0;\r\n  border-radius: 8px;\r\n  padding: 8px 10px;\r\n  margin: 12px 0 10px;\r\n  background: #fafbfd;\r\n}\r\n.mg-index-progress > div { display: flex; align-items: center; gap: 8px; }\r\n.mg-index-progress b { font-size: 12px; font-weight: 600; color: #334155; }\r\n.mg-index-progress > div > span,\r\n.mg-index-progress p { font-size: 12px; color: #6b7280; font-variant-numeric: tabular-nums; }\r\n.mg-index-progress progress {\r\n  display: block;\r\n  grid-column: 1 / -1;\r\n  grid-row: 2;\r\n  width: 100%;\r\n  height: 5px;\r\n  appearance: none;\r\n  border: 0;\r\n  border-radius: 99px;\r\n  overflow: hidden;\r\n  background: #e9edf3;\r\n  accent-color: var(--primary, #2c56a0);\r\n}\r\n.mg-index-progress progress::-webkit-progress-bar { background: #e9edf3; border-radius: 99px; }\r\n.mg-index-progress progress::-webkit-progress-value { background: var(--primary, #2c56a0); border-radius: 99px; }\r\n.mg-index-progress progress::-moz-progress-bar { background: var(--primary, #2c56a0); border-radius: 99px; }\r\n.mg-index-progress p { margin: 0; text-align: right; }\r\n.mg-index-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }\r\n.mg-job-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin-left: 6px;\r\n  font-size: 12px;\r\n  color: #6b7280;\r\n}\r\n.mg-job-status-running { color: var(--primary, #2c56a0); }\r\n.mg-job-status-success { color: #2f7d4a; }\r\n.mg-job-status-error { color: #b42318; }\r\n.mg-job-status-cancelled { color: #9a6700; }\r\n.mg-job-id, .mg-job-elapsed { display: block; margin-top: 2px; color: #6b7280; font-size: 11px; }\r\n.mg-job-error { display: block; margin-top: 2px; color: #b42318; font-size: 11px; line-height: 1.4; overflow-wrap: anywhere; }\r\n.mg-job-annotation { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; margin-top: 7px; }\r\n.mg-job-annotation .mg-category-chip { max-width: 100%; padding: 1px 7px; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.mg-category-chip.is-empty { color: #94a3b8; background: transparent; border-style: dashed; }\r\n.mg-job-custom { padding: 1px 7px; border-radius: 999px; background: #fff4e5; color: #9a6700; font-size: 11px; }\r\n.mg-job-extras { color: #7b8899; font-size: 11px; }\r\n.mg-job-scenes { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }\r\n.mg-job-edit { margin-top: 6px; font-size: 12px; }\r\n.mg-job-edit:disabled { color: var(--muted); cursor: not-allowed; text-decoration: none; }\r\n.mg-job-note { display: block; margin-top: 4px; color: #9a6700; font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }\r\n.mg-upload-card.mg-job-success { box-shadow: inset 0 0 0 1px #c6e2d0; }\r\n.mg-upload-card.mg-job-error { box-shadow: inset 0 0 0 1px #f0c2bc; }\r\n.mg-upload-card.mg-job-running { box-shadow: inset 0 0 0 1px #c9daf3; }\r\n.mg-task-list { display: flex; flex-direction: column; }\r\n.mg-task-row {\r\n  display: grid;\r\n  grid-template-columns: 1.6fr 0.7fr 0.8fr 1.2fr;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding: 10px 18px;\r\n  border-top: 1px solid #eef1f5;\r\n  font-size: 13px;\r\n}\r\n.mg-task-name { display: flex; align-items: center; gap: 10px; min-width: 0; }\r\n.mg-task-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }\r\n.mg-task-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e9f0; background: #f7f8fa; flex-shrink: 0; }\r\n.mg-task-progress { color: #6b7280; font-variant-numeric: tabular-nums; }\r\n.mg-task-detail { color: #6b7280; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }\r\n.mg-task-head { grid-template-columns: 1.6fr 0.7fr 0.8fr 1.2fr; }\r\n@media (max-width: 580px) {\r\n  .mg-task-row, .mg-task-head { grid-template-columns: 1.4fr 0.8fr 1fr; }\r\n  .mg-task-row > :last-child, .mg-task-head > :last-child { display: none; }\r\n}\r\n\r\n\r\n/* library list wired to GET /api/images */\r\n.mg-library-grid { padding-top: 16px; }\r\n.mg-library-grid.is-loading,\r\n.mg-library-list.is-loading { opacity: .72; pointer-events: none; }\r\n.mg-library-placeholder {\r\n  display: grid; place-items: center; width: 100%; height: 100%;\r\n  color: #94a3b8; background: #eef2f7;\r\n}\r\n.mg-upload-preview:disabled { cursor: default; }\r\n.mg-upload-preview:disabled:hover img { transform: none; }\r\n.mg-library-scene {\r\n  display: inline-flex; align-items: center; padding: 1px 6px;\r\n  border-radius: 999px; background: #eef2ff; color: #4f6fad; font-size: 11px;\r\n}\r\n/* Library cards: chips keep their own height and line up from the left */\r\n.mg-library-card small { justify-content: flex-start; align-items: center; }\r\n.mg-label-status { display: inline-flex; align-items: center; padding: 0 6px; border-radius: 999px; font-size: 11px; line-height: 18px; }\r\n.mg-label-status.is-auto { background: #eef2f7; color: #64748b; }\r\n.mg-label-status.is-verified { background: #eaf5ee; color: #2f7d4a; }\r\n.mg-library-tags { justify-content: flex-start !important; gap: 4px 8px !important; margin-top: 4px !important; color: #64748b !important; font-size: 11px !important; overflow-wrap: anywhere; }\r\n.mg-attributes .mg-label-status { margin-right: 6px; }\r\n/* The image's vector store state, only when it needs attention */\r\n.mg-vector-flag { display: inline-flex; align-items: center; gap: 4px; padding: 0 6px; border-radius: 999px; font-size: 11px; line-height: 18px; white-space: nowrap; cursor: help; }\r\n.mg-vector-flag::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }\r\n.mg-vector-flag.is-stale { background: #fff4e5; color: #9a6700; }\r\n.mg-vector-flag.is-missing { background: #fdf0ee; color: #b42318; }\r\n.mg-attributes .mg-vector-flag { margin-right: 6px; }\r\n.mg-vector-tally { color: #9a6700; }\r\n.mg-library-list { display: flex; flex-direction: column; }\r\n.mg-library-row {\r\n  display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; align-items: center;\r\n  gap: 18px; padding: 10px 18px; border-bottom: 1px solid var(--border); font-size: 13px;\r\n}\r\n.mg-library-name {\r\n  display: flex; align-items: center; gap: 10px; min-width: 0;\r\n  padding: 0; border: 0; background: none; text-align: left;\r\n  font: inherit; color: inherit; cursor: pointer;\r\n}\r\n.mg-library-name:disabled { cursor: default; }\r\n.mg-library-name strong {\r\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500;\r\n}\r\n.mg-library-thumb {\r\n  width: 40px; height: 40px; flex-shrink: 0; border-radius: 6px;\r\n  object-fit: cover; background: #eef2f7;\r\n}\r\n.mg-library-thumb.mg-library-placeholder { color: #94a3b8; }\r\n.mg-errors > p { margin: 8px 0 0; line-height: 1.7; }\r\n.mg-panel > .loading-state { padding-top: 36px; padding-bottom: 28px; }\r\n@media (max-width: 860px) {\r\n  .mg-library-row { grid-template-columns: 1.4fr .8fr; gap: 10px; }\r\n  .mg-library-row > span:nth-child(3),\r\n  .mg-library-row > span:nth-child(4) { display: none; }\r\n}\r\n"],["STYLE",{},".enum-page { display: flex; flex-direction: column; gap: 12px; min-width: 0; }\r\n\r\n.enum-alert { margin: 0; }\r\n.enum-alert p { margin: 8px 0 0; line-height: 1.7; overflow-wrap: anywhere; }\r\n.enum-alert-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 8px; }\r\n.enum-trace { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; overflow-wrap: anywhere; }\r\n\r\n.enum-split {\r\n  display: grid;\r\n  grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);\r\n  gap: 14px;\r\n  align-items: start;\r\n}\r\n\r\n.enum-pane { min-width: 0; }\r\n.enum-pane-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 12px 14px;\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n.enum-pane-heading h2 { margin: 0; font-size: 16px; font-weight: 700; }\r\n\r\n.enum-back { display: none; }\r\n\r\n.enum-list-items { max-height: min(70vh, 720px); margin: 0; padding: 0; overflow: auto; list-style: none; }\r\n.enum-list-items li { margin: 0; padding: 0; }\r\n.enum-option {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 2px 10px;\r\n  width: 100%;\r\n  padding: 10px 14px;\r\n  border: 0;\r\n  border-bottom: 1px solid var(--border);\r\n  background: transparent;\r\n  color: inherit;\r\n  font: inherit;\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n.enum-option:hover { background: var(--hover); }\r\n.enum-option[aria-current='true'] { background: var(--active); }\r\n.enum-option:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }\r\n.enum-option strong { font-size: 14px; font-weight: 600; }\r\n.enum-option code { grid-column: 1; color: var(--muted); font-size: 12px; }\r\n.enum-option-meta { grid-column: 2; grid-row: 1 / span 2; align-self: center; text-align: right; }\r\n.enum-count { display: block; color: var(--muted); font-size: 12px; }\r\n.enum-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  margin-top: 4px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  background: #eef2f6;\r\n  color: #64748b;\r\n  font-size: 11px;\r\n}\r\n.enum-badge-editable { background: var(--primary-soft); color: var(--primary); }\r\n\r\n.enum-detail-body { padding: 14px; }\r\n.enum-meta { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 8px 12px; margin: 0 0 14px; font-size: 14px; }\r\n.enum-meta dt { color: var(--muted); }\r\n.enum-meta dd { margin: 0; overflow-wrap: anywhere; }\r\n.enum-detail-status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 12px; }\r\n.enum-note { margin: 8px 0 0; color: var(--muted); font-size: 13px; line-height: 1.7; }\r\n\r\n.enum-table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }\r\n.enum-table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 13px; }\r\n.enum-table th, .enum-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; overflow-wrap: anywhere; }\r\n.enum-table th { background: #f6f7f8; color: #334155; font-weight: 700; }\r\n.enum-table tr:last-child td { border-bottom: 0; }\r\n.enum-empty-values { color: var(--muted); text-align: center; }\r\n\r\n.enum-field-error { margin: 6px 0 0; color: #b16464; font-size: 13px; }\r\n.enum-form input[aria-invalid='true'],\r\n.enum-form textarea[aria-invalid='true'] { border-color: #e2b4b4; background: #fff8f7; }\r\n.enum-form .mg-field > .enum-field-error { grid-column: 2; }\r\n.enum-refresh-warning { margin: 0 0 12px; padding: 10px 12px; border: 1px solid #dcebe4; border-radius: 5px; background: #f5faf8; color: #3f6b5c; font-size: 13px; line-height: 1.7; }\r\n\r\n@media (max-width: 760px) {\r\n  .enum-split { display: block; }\r\n  .enum-split.is-list .enum-detail { display: none; }\r\n  .enum-split.is-detail .enum-list { display: none; }\r\n  .enum-back { display: inline-flex; margin: 12px 14px 0; }\r\n  .enum-list-items { max-height: none; }\r\n  .enum-option { min-height: 44px; }\r\n}\r\n@media (max-width: 580px) {\r\n  .enum-form .mg-field > .enum-field-error { grid-column: 1; }\r\n}\r\n"],["STYLE",{},"/* 食材管理: the category tree as a management table (toolbar, panel, table head and rows as in\r\n   ManagementViews.css), plus the editor and delete dialogs. */\r\n.ct-page code,\r\n.cat-form code,\r\n.ct-confirm code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }\r\n\r\n.ct-connection.is-online > span { background: #599987; }\r\n.ct-connection.is-error > span { background: #c5a16b; }\r\n\r\n\r\n.ct-alert { margin: 14px 18px; }\r\n.ct-alert p { margin: 6px 0 0; line-height: 1.7; overflow-wrap: anywhere; }\r\n.ct-trace { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; }\r\n.ct-alert-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 10px; }\r\n.ct-alert-actions .mg-btn { height: 32px; font-size: 13px; }\r\n\r\n/* -- table -------------------------------------------------------------------------- */\r\n.ct-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(230px, 2.5fr) minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, .9fr) minmax(0, .9fr) 64px 118px;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n.ct-head { border-top: 0; }\r\n.ct-list { margin: 0; padding: 0; list-style: none; }\r\n/* One line per category: the row height decides how much of a group fits on the screen */\r\n.ct-row { min-height: 38px; padding: 1px 18px; border-bottom: 1px solid #edf0f5; font-size: 14px; scroll-margin-top: 46px; }\r\n.ct-row.is-odd { background: #fafbfe; }\r\n.ct-row:hover { background: #f4f8fe; }\r\n.ct-row.is-last { border-bottom: 0; }\r\n.ct-row.is-selected { background: #eef4ff; box-shadow: inset 3px 0 0 var(--primary); }\r\n.ct-cell { min-width: 0; }\r\n\r\n.ct-col-name { display: flex; align-items: center; gap: 2px; padding-left: calc(var(--ct-depth, 0) * 22px); }\r\n.ct-toggle { display: grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 6px; color: #64748b; }\r\n.ct-toggle:hover:not(.ct-toggle-static) { background: var(--hover); color: var(--primary); }\r\n.ct-toggle-static { color: #b6c0cd; pointer-events: none; }\r\n.ct-icon { display: grid; place-items: center; flex-shrink: 0; width: 25px; height: 25px; color: #64748b; }\r\n.ct-row.is-inactive .ct-icon { color: #a8b2bf; }\r\n.ct-label { display: flex; flex: 1 1 auto; align-items: center; gap: 10px; min-width: 0; padding: 3px 6px; border-radius: 6px; text-align: left; }\r\n.ct-label:hover strong { color: var(--primary); }\r\n.ct-label-line { display: flex; flex: 0 1 auto; align-items: center; gap: 6px; min-width: 0; }\r\n.ct-label strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); font-size: 14px; font-weight: 500; }\r\n/* The code takes what the name leaves; right-to-left so a long one loses its front (the parents'\r\n   segments) and keeps its own last segment in view */\r\n.ct-code { flex: 1 1 0; min-width: 0; overflow: hidden; direction: rtl; text-align: left; text-overflow: ellipsis; white-space: nowrap; color: #94a3b8; font-size: 12px; }\r\n.ct-row.is-inactive .ct-label strong { color: #64748b; }\r\n.ct-row.is-context .ct-label strong { color: #7b8899; font-weight: 400; }\r\n.ct-count { flex-shrink: 0; padding: 0 6px; border-radius: 999px; background: #eef2f6; color: #64748b; font-size: 11px; line-height: 18px; }\r\n.ct-label:focus-visible { outline-offset: 0; }\r\n\r\n.ct-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; min-width: 0; }\r\n.ct-row .ct-chips { flex-wrap: nowrap; overflow: hidden; }\r\n.ct-row .ct-chip { flex-shrink: 0; }\r\n.ct-row .ct-chip:first-child { flex-shrink: 1; min-width: 0; }\r\n.ct-chip { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 0 7px; border: 1px solid #e5eaf2; border-radius: 6px; background: #f6f7f8; color: #475569; font-size: 12px; line-height: 22px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.ct-chip i { color: #94a3b8; font-size: 11px; font-style: normal; }\r\n.ct-more { color: var(--muted); font-size: 12px; }\r\n.ct-none { color: #a8b2bf; }\r\n.ct-heating, .ct-usage { display: block; overflow: hidden; color: #475569; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }\r\n.ct-inherited { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; color: #7b8899; font-size: 13px; }\r\n.ct-inherited-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.ct-inherited small { flex-shrink: 0; padding: 0 5px; border: 1px dashed #d5dce6; border-radius: 4px; color: #94a3b8; font-size: 11px; line-height: 16px; }\r\n\r\n.ct-state { display: inline-flex; align-items: center; gap: 5px; padding: 0 8px; border-radius: 999px; font-size: 12px; line-height: 22px; white-space: nowrap; }\r\n.ct-state::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }\r\n/* Most categories are active: keep that quiet so a disabled one stands out */\r\n.ct-state.is-active { padding-left: 0; color: #4b8b63; }\r\n.ct-state.is-inactive { background: #f6efe4; color: #8a6a3c; }\r\n.ct-state-inline { display: none; }\r\n\r\n.ct-row .mg-row-actions { gap: 4px; }\r\n.ct-row .mg-row-actions button { width: 32px; height: 32px; }\r\n.ct-head .ct-col-actions { padding-left: 4px; }\r\n\r\n/* A wide screen: the page keeps its height; the rows scroll inside the panel under a table head\r\n   that stays, with the toolbar above and the counts below always in view */\r\n@media (min-width: 901px) and (min-height: 560px) {\r\n  main.management-page:has(> .ct-page) { display: flex; flex-direction: column; overflow: hidden; }\r\n  .mg-page.ct-page { display: flex; flex: 1; flex-direction: column; min-height: 0; padding: 0; }\r\n  .ct-page > * { flex-shrink: 0; }\r\n  .ct-page > .ct-panel { display: flex; flex: 1 1 0; flex-direction: column; min-height: 0; }\r\n  .ct-panel > * { flex-shrink: 0; }\r\n  .ct-panel > .ct-table { flex: 1 1 0; min-height: 0; overflow: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #d5dde8 transparent; }\r\n  .ct-head { position: sticky; top: 0; z-index: 2; }\r\n  .ct-page > .mg-info { margin-top: 8px; }\r\n}\r\n\r\n.ct-footer > div { gap: 14px; }\r\n/* .mg-pagination styles its buttons as page arrows; these are text buttons */\r\n.ct-footer .mg-text-button { display: inline-flex; padding: 3px 0; border: 0; border-radius: 0; background: none; color: var(--primary); }\r\n.ct-footer .mg-text-button:disabled { color: var(--muted); cursor: not-allowed; text-decoration: none; }\r\n.ct-panel > .mg-empty { padding-top: 44px; }\r\n\r\n/* -- delete dialog ------------------------------------------------------------------ */\r\n.ct-confirm { padding: 16px; font-size: 14px; line-height: 1.8; }\r\n.ct-confirm p { margin: 0; overflow-wrap: anywhere; }\r\n.ct-uses { margin: 6px 0 10px; padding-left: 20px; color: #334155; }\r\n.ct-confirm-note { color: var(--muted); font-size: 13px; }\r\n.ct-confirm .mg-form-error { margin: 12px 0 0; }\r\n.ct-danger-solid { color: #fff; background: #b65555; border-color: #b65555; }\r\n.ct-danger-solid:hover:not(:disabled) { background: #a44848; border-color: #a44848; }\r\n\r\n/* -- editor dialog ------------------------------------------------------------------ */\r\n.ct-editor-meta { flex-wrap: wrap; }\r\n.cat-field-error { margin: 0; color: #b16464; font-size: 13px; line-height: 1.6; }\r\n.cat-form .mg-field > .cat-field-error { grid-column: 2; }\r\n.cat-form input[aria-invalid='true'],\r\n.cat-form select[aria-invalid='true'] { border-color: #e2b4b4; background: #fff8f7; }\r\n.cat-form .mg-field > input:disabled,\r\n.cat-form .mg-field > select:disabled { background: #f3f5f8; color: #64748b; }\r\n/* 上级类别: the picked parent above the searchable tree (category-picker) */\r\n.cat-parent { min-width: 0; }\r\n.cat-parent .cp-selected, .cat-parent .cp-combo { margin-top: 0; }\r\n.cat-parent .cp-selected + .cp-search .cp-combo { margin-top: 6px; }\r\n.cat-parent-current code { font-size: 11px; }\r\n.cat-parent.is-invalid .cp-combo, .cat-parent.is-invalid .cp-selected { border-color: #e2b4b4; }\r\n.cat-form .cp-combo input[aria-invalid='true'] { background: transparent; }\r\n.cat-same-name { grid-column: 2; margin: 0; padding: 6px 10px; border: 1px solid #f1e3b4; border-radius: 8px; background: #fffaf0; color: #7a5b00; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\r\n.cat-created { margin-right: auto; align-self: center; color: #4b8b63; font-size: 13px; }\r\n.cat-names { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; }\r\n.cat-name-row { display: grid; grid-template-columns: 68px minmax(0, 1fr) 84px 28px; align-items: center; gap: 6px; width: 100%; }\r\n.cat-name-row input,\r\n.cat-name-row select {\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  min-width: 0;\r\n  min-height: 36px;\r\n  padding: 6px 9px;\r\n  border: 1px solid #d7e0ee;\r\n  border-radius: 10px;\r\n  background: #fff;\r\n  color: #223046;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n}\r\n.cat-check { display: inline-flex; align-items: center; gap: 8px; padding-top: 7px; color: #223046; font-size: 14px; cursor: pointer; }\r\n.cat-check input { width: 16px; height: 16px; margin: 0; accent-color: var(--primary); }\r\n.mg-editor-note.cat-code-preview { display: block; color: #51627b; }\r\n.cat-code-preview p { margin: 6px 0; }\r\n.cat-code-preview ul { margin: 6px 0; padding-left: 20px; }\r\n.cat-code-preview li { margin: 4px 0; overflow-wrap: anywhere; }\r\n\r\n/* -- narrower screens: columns drop out from the least needed ------------------------- */\r\n@media (max-width: 1360px) {\r\n  .ct-grid { grid-template-columns: minmax(220px, 2.4fr) minmax(0, 1fr) minmax(0, .9fr) minmax(0, .9fr) 64px 118px; }\r\n  .ct-col-names { display: none; }\r\n}\r\n@media (max-width: 1100px) {\r\n  .ct-grid { grid-template-columns: minmax(200px, 2.2fr) minmax(0, 1fr) minmax(0, .9fr) 64px 118px; }\r\n  .ct-col-usage { display: none; }\r\n}\r\n@media (max-width: 860px) {\r\n  .ct-grid { grid-template-columns: minmax(0, 1fr) 64px 118px; gap: 10px; }\r\n  .ct-col-cuisines, .ct-col-heating { display: none; }\r\n}\r\n@media (max-width: 580px) {\r\n  .ct-grid { grid-template-columns: minmax(0, 1fr) 104px; gap: 6px; }\r\n  .ct-col-status { display: none; }\r\n  .ct-state-inline { display: inline-flex; }\r\n  .ct-row { padding: 6px 10px; }\r\n  .ct-head { padding: 10px; }\r\n  .ct-col-name { padding-left: calc(var(--ct-depth, 0) * 14px); }\r\n  .ct-icon { display: none; }\r\n  .ct-row .mg-row-actions { gap: 2px; }\r\n  .ct-row .mg-row-actions button { width: 32px; height: 32px; }\r\n  .ct-alert { margin: 12px; }\r\n  .cat-form .mg-field > .cat-field-error, .cat-same-name { grid-column: 1; }\r\n  .cat-name-row { grid-template-columns: 56px minmax(0, 1fr) 76px 28px; }\r\n}\r\n"],["STYLE",{},".model-versions { display: flex; flex-direction: column; gap: 14px; min-width: 0; }\n.model-versions-status { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 14px; }\n/* the metric values here are version names, not numbers: label above, value wraps */\n.model-versions .mg-metrics { margin-bottom: 0; }\n.model-versions .mg-metric { min-width: 0; }\n.model-versions .mg-metric > div { grid-template-columns: minmax(0, 1fr); gap: 4px; min-width: 0; }\n.model-versions .mg-metric strong { font-size: 17px; line-height: 1.3; overflow-wrap: anywhere; }\n.model-versions .mg-metric small { overflow-wrap: anywhere; }\n\n/* what to do next */\n.model-guide { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px 14px; padding: 14px 16px; border: 1px solid #d7e2ff; border-radius: 12px; background: #f5f8ff; color: #334155; }\n.model-guide > svg { flex-shrink: 0; margin-top: 2px; color: var(--primary); }\n.model-guide > div { flex: 1 1 280px; min-width: 0; }\n.model-guide strong { display: block; color: var(--text); font-size: 15px; }\n.model-guide p { margin: 4px 0 0; font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; }\n.model-guide > .mg-btn { align-self: center; }\n.model-guide.is-ok { border-color: #c6e7d2; background: #f3fbf6; }\n.model-guide.is-ok > svg { color: #15803d; }\n.model-guide.is-warn { border-color: #f1d9b5; background: #fffaf2; }\n.model-guide.is-warn > svg { color: #b45309; }\n.model-guide.is-error { border-color: #f1c4be; background: #fdf3f1; }\n.model-guide.is-error > svg { color: #b42318; }\n\n.model-steps { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 10px 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 13px; }\n.model-steps li { display: inline-flex; align-items: center; gap: 6px; }\n.model-steps li > span { display: inline-grid; place-items: center; width: 20px; height: 20px; border: 1px solid #cbd5e1; border-radius: 50%; font-size: 12px; }\n.model-steps li.is-current { color: var(--primary); font-weight: 600; }\n.model-steps li.is-current > span { border-color: var(--primary); background: var(--primary); color: #fff; }\n.model-steps li.is-done { color: #15803d; }\n.model-steps li.is-done > span { border-color: transparent; color: #15803d; }\n\n/* build progress */\n.model-build { padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); }\n.model-build-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }\n.model-build-head strong { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; }\n.model-build-head .mg-btn { margin-left: auto; }\n.model-build-state { padding: 2px 8px; border-radius: 999px; background: #eef2f7; color: #475569; font-size: 12px; }\n.model-build-state.is-running, .model-build-state.is-stopping { background: #eaf2ff; color: #1d4ed8; }\n.model-build-state.is-done { background: #e9f7ef; color: #15803d; }\n.model-build-state.is-failed { background: #fdecea; color: #b42318; }\n.model-build .model-coverage { margin-top: 12px; }\n.model-build-counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 8px; margin: 12px 0 0; }\n.model-build-counts div { padding: 8px 10px; border: 1px solid #edf0f5; border-radius: 8px; }\n.model-build-counts dt { color: var(--muted); font-size: 12px; }\n.model-build-counts dd { margin: 2px 0 0; font-size: 18px; font-weight: 700; }\n.model-build-counts .is-warn dd { color: #b45309; }\n.model-build-counts small { display: block; margin-top: 2px; color: #b45309; font-size: 12px; }\n.model-build-note { margin: 10px 0 0; color: #6b7280; font-size: 13px; line-height: 1.8; }\n.model-build-failures { margin-top: 10px; font-size: 13px; }\n.model-build-failures summary { cursor: pointer; color: #b45309; }\n.model-build-failures ul { max-height: 220px; margin: 8px 0; padding-left: 18px; overflow: auto; }\n.model-build-failures li { line-height: 1.8; overflow-wrap: anywhere; }\n.model-build-failures code { margin-right: 8px; font-size: 12px; }\n.model-build-failures p { margin: 0; color: #6b7280; }\n\n/* versions */\n.model-row { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(180px, 1fr) auto; align-items: center; gap: 12px 18px; padding: 14px 18px; border-bottom: 1px solid #edf0f5; }\n.model-row:last-child { border-bottom: 0; }\n.model-row.is-retired { opacity: .7; }\n.model-row-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n.model-row-main small { color: var(--muted); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }\n.model-row-main code, .model-dialog code { font-size: 12px; overflow-wrap: anywhere; }\n.model-row-title { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }\n.model-row-title strong { font-size: 15px; overflow-wrap: anywhere; }\n.model-status, .model-tag { padding: 1px 8px; border: 1px solid transparent; border-radius: 999px; font-size: 12px; white-space: nowrap; }\n.model-status { background: #eef2f7; color: #475569; }\n.model-status.is-current { background: #e9f7ef; color: #15803d; }\n.model-status.is-ready { background: #eaf2ff; color: #1d4ed8; }\n.model-status.is-building { background: #fff4e5; color: #b45309; }\n.model-tag { border-color: #d7e2ff; color: #334155; }\n.model-tag.is-serving { border-color: #c6e7d2; color: #15803d; }\n.model-tag.is-unknown, .model-tag.is-warn { border-color: #f1d9b5; color: #b45309; }\n.model-row-coverage > small.is-warn { color: #b45309; }\n.model-row-coverage { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n.model-row-coverage > small { color: var(--muted); font-size: 12px; }\n.model-row-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }\n.model-coverage small { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; }\n.model-coverage small strong { color: #b45309; }\n.model-coverage-bar { height: 6px; border-radius: 999px; background: #edf0f5; overflow: hidden; }\n.model-coverage-bar > span { display: block; height: 100%; border-radius: inherit; background: var(--primary); transition: width .3s; }\n.model-row.is-current .model-coverage-bar > span { background: #16a34a; }\n.model-retired { border-top: 1px solid var(--border); }\n.model-retired summary { padding: 10px 18px; color: var(--muted); font-size: 13px; cursor: pointer; }\n\n.mg-btn.model-danger { border-color: #c2412f; background: #c2412f; color: #fff; }\n.mg-btn.model-danger:hover:not(:disabled) { border-color: #a8382a; background: #a8382a; }\n.mg-btn.model-danger-quiet { border-color: #f1c4be; background: #fdf0ee; color: #b42318; }\n.mg-btn.model-danger-quiet:hover:not(:disabled) { border-color: #e9a59c; background: #fbe4e0; }\n\n.model-help { padding: 12px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-bg); color: #475569; font-size: 13px; }\n.model-help summary { cursor: pointer; color: #334155; }\n.model-help ul { margin: 8px 0 0; padding-left: 18px; line-height: 1.9; }\n\n/* dialogs */\n.model-dialog { display: flex; flex-direction: column; gap: 10px; padding: 4px 4px 8px; font-size: 14px; line-height: 1.8; }\n.model-dialog p { margin: 0; }\n.model-dialog-facts { display: grid; gap: 4px; margin: 0; padding: 8px 10px; border-radius: 8px; background: #f6f8fb; font-size: 13px; }\n.model-dialog-facts div { display: flex; gap: 8px; min-width: 0; }\n.model-dialog-facts dt { flex-shrink: 0; color: var(--muted); }\n.model-dialog-facts dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }\n.model-dialog-field { display: flex; flex-direction: column; gap: 4px; color: #475569; font-size: 13px; }\n.model-dialog-field input { padding: 7px 10px; border: 1px solid #d7dde6; border-radius: 8px; font: inherit; font-size: 14px; }\n.model-dialog-note { color: #6b7280; font-size: 12px; }\n.model-dialog-note.is-info { padding: 8px 10px; border-radius: 8px; background: #f5f8ff; color: #334155; font-size: 13px; }\n.model-dialog-warn { display: flex; gap: 8px; padding: 10px 12px; border: 1px solid #f1d9b5; border-radius: 8px; background: #fffaf2; color: #92400e; font-size: 13px; }\n.model-dialog-warn svg { flex-shrink: 0; margin-top: 4px; }\n.model-dialog-warn label { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-weight: 600; cursor: pointer; }\n.model-dialog-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; padding: 10px 14px; border-top: 1px solid rgba(148, 163, 184, .22); }\n\n@media (max-width: 760px) {\n  .model-versions .mg-metrics { grid-template-columns: minmax(0, 1fr); }\n  .model-row { grid-template-columns: minmax(0, 1fr); }\n  .model-row-actions { justify-content: flex-start; }\n  .model-build-head .mg-btn { margin-left: 0; }\n}\n"],["STYLE",{},".batch-search-panel { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 12px; font-size: 14px; }\r\n.batch-controls { display: flex; flex-direction: column; gap: 8px; min-width: 0; }\r\n.batch-upload { border: 1px dashed #c8d4e6; background: #fbfcfe; border-radius: 10px; transition: background .15s, border-color .15s; }\r\n.batch-controls .batch-upload { width: 100%; min-width: 0; }\r\n.batch-upload.is-dragging { background: #edf4ff; border-color: #7396cf; }\r\n.batch-upload>.batch-upload-trigger { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 64px; padding: 9px 10px; text-align: left; border-radius: inherit; }\r\n.batch-upload>.batch-upload-trigger:hover:not([aria-disabled=\"true\"]) { background: #f2f6fc; }\r\n.batch-upload>.batch-upload-trigger[aria-disabled=\"true\"] { opacity: .55; cursor: not-allowed; }\r\n.batch-upload-icon { width: 32px; height: 32px; flex-shrink: 0; display: grid; place-items: center; border: 1px solid #dee6f2; border-radius: 8px; background: #f2f5fa; color: #6e89b3; }\r\n.batch-upload-copy { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\r\n.batch-upload b { color: #334155; font-size: 13px; font-weight: 600; }\r\n.batch-upload-copy>span { font-size: 11px; color: #6b7280; line-height: 1.5; }\r\n.batch-run-actions { display: flex; flex-wrap: wrap; gap: 8px; }\r\n.batch-run-actions .btn { flex: 1; padding-inline: 10px; white-space: nowrap; }\r\n.batch-selected-preview { margin: 0; min-width: 0; border: 1px solid #e4e9f0; border-radius: 9px; overflow: hidden; background: #f7f8fa; }\r\n.batch-selected-heading { display: flex; align-items: center; gap: 5px; padding: 6px 8px; border-bottom: 1px solid #e6eaf0; background: #fff; }\r\n.batch-selected-heading b { flex: 1; font-size: 12px; font-weight: 600; color: #334155; }\r\n.batch-selected-heading>span { color: #7b8899; font-size: 12px; font-variant-numeric: tabular-nums; }\r\n.batch-selected-heading .icon-button { width: 26px; height: 26px; }\r\n.batch-selected-image { display: block; width: 100%; height: 208px; object-fit: contain; padding: 8px; }\r\n.batch-selected-preview figcaption { padding: 7px 10px; border-top: 1px solid #e6eaf0; background: #fff; color: #475569; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.batch-progress { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 7px; border: 1px solid #e4e9f0; border-radius: 8px; padding: 8px 10px; background: #fafbfd; }\r\n.batch-progress>div { display: flex; align-items: center; gap: 8px; }\r\n.batch-progress b { font-size: 12px; font-weight: 600; color: #334155; }\r\n.batch-progress>div>span, .batch-progress p { font-size: 12px; color: #6b7280; font-variant-numeric: tabular-nums; }\r\n.batch-progress progress { display: block; grid-column: 1 / -1; grid-row: 2; width: 100%; height: 5px; appearance: none; border: 0; border-radius: 99px; overflow: hidden; background: #e9edf3; accent-color: #6f96d2; }\r\n.batch-progress progress::-webkit-progress-bar { background: #e9edf3; border-radius: 99px; }\r\n.batch-progress progress::-webkit-progress-value { background: #6f96d2; border-radius: 99px; }\r\n.batch-progress progress::-moz-progress-bar { background: #6f96d2; border-radius: 99px; }\r\n.batch-progress p { margin: 0; text-align: right; }\r\n.batch-queue-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\r\n.batch-queue-heading h3 { display: flex; align-items: center; gap: 6px; color: #334155; font-size: 14px; font-weight: 600; }\r\n.batch-queue-heading h3>span { color: #7b8899; font-size: 12px; font-weight: 400; }\r\n.batch-queue-heading .text-button { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; }\r\n.batch-queue { display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; padding: 0; margin: 0; list-style: none; }\r\n.batch-job { display: flex; align-items: flex-start; position: relative; min-width: 0; padding: 8px; gap: 8px; border: 1px solid #e6eaf0; border-radius: 8px; background: #fff; }\r\n.batch-job.is-viewed { border-color: #b8cfee; background: #f8faff; }\r\n.batch-job-running { border-color: #c6d7ef; }\r\n.batch-job-preview-button { display: block; flex-shrink: 0; align-self: flex-start; border-radius: 5px; padding: 0; }\r\n.batch-job-preview-button:hover { box-shadow: 0 0 0 2px #c6d7ef; }\r\n.batch-job-preview-button:focus-visible { outline: 2px solid #6f96d2; outline-offset: 2px; }\r\n.batch-job-preview-button[aria-pressed=\"true\"] { box-shadow: 0 0 0 2px #8eadde; }\r\n.batch-job-preview { width: 54px; height: 54px; flex-shrink: 0; object-fit: contain; border: 1px solid #e6eaf0; background: #f6f7f9; border-radius: 5px; }\r\n.batch-job-info { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding-right: 16px; }\r\n.batch-job-info>b { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; font-weight: 500; color: #334155; }\r\n.batch-job-status { display: inline-flex; align-items: center; gap: 4px; color: #778292; font-size: 12px; }\r\n.batch-job-success .batch-job-status { color: #4f8874; }\r\n.batch-job-error .batch-job-status { color: #b56059; }\r\n.batch-job-running .batch-job-status { color: #4f75ad; }\r\n.batch-job-meta { font-size: 12px; color: #7b8899; }\r\n.batch-job-error, .batch-job-message { font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }\r\n.batch-job-error { color: #a85e58; }\r\n.batch-job-message { color: #8b7149; }\r\n.batch-view-result.text-button { padding: 2px 0; font-size: 12px; }\r\n.batch-remove { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; }\r\n.batch-empty { display: flex; align-items: center; gap: 7px; color: #7b8899; font-size: 12px; margin: 0; }\r\n.batch-empty svg { flex-shrink: 0; }\r\n@media (max-width: 650px) {\r\n  .batch-search-panel { padding: 10px 12px; }\r\n}\r\n"],["STYLE",{},".download-dialog-content { display: grid; gap: 16px; padding: 20px; font-size: 15px; line-height: 1.65; }\r\n.download-dialog-content p { margin: 0; }\r\n.download-intro { color: var(--muted); }\r\n.download-modes { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }\r\n.download-modes legend { margin-bottom: 9px; font-weight: 650; }\r\n.download-mode { display: flex; align-items: center; gap: 10px; padding: 15px 12px; background: #fff; border: 1px solid #dde2ea; border-radius: 10px; cursor: pointer; min-width: 0; }\r\n.download-mode.is-selected { background: #f1f6ff; border-color: #9cb9e4; }\r\n.download-mode.is-unavailable { color: #7a818b; cursor: default; background: #f5f6f8; }\r\n.download-mode input { width: 16px; height: 16px; margin: 0; flex-shrink: 0; accent-color: var(--primary); }\r\n.download-mode>svg { color: #6882a5; flex-shrink: 0; }\r\n.download-mode strong { display: block; font-size: 15px; font-weight: 650; }\r\n.download-mode small { display: block; color: var(--muted); font-size: 13px; margin-top: 2px; line-height: 1.6; }\r\n.download-destination { padding: 13px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }\r\n.download-destination>span { display: flex; align-items: center; gap: 8px; flex: 1; min-width: 160px; overflow-wrap: anywhere; }\r\n.download-destination>span strong { font-size: 14px; }\r\n.download-destination>small { width: 100%; color: var(--muted); font-size: 13px; }\r\n.download-help, .download-limits { color: var(--muted); font-size: 13px; line-height: 1.8; }\r\n.download-limits { padding: 10px 12px; border-radius: 8px; background: #f0f2f5; }\r\n.download-progress { display: grid; gap: 10px; padding: 16px; border-radius: 10px; border: 1px solid var(--border); background: #fff; }\r\n.download-progress-title { display: flex; justify-content: space-between; gap: 10px; }\r\n.download-progress-title strong { font-weight: 650; }\r\n.download-progress-title>span { color: var(--muted); font-variant-numeric: tabular-nums; }\r\n.download-progress progress { width: 100%; height: 9px; border: 0; border-radius: 9px; accent-color: #769bd0; overflow: hidden; }\r\n.download-progress progress::-webkit-progress-bar { background: #eef1f6; border-radius: 9px; }\r\n.download-progress progress::-webkit-progress-value { background: #769bd0; border-radius: 9px; transition: width .15s; }\r\n.download-statistics { display: flex; flex-wrap: wrap; gap: 7px 22px; color: var(--muted); font-size: 13px; }\r\n.download-statistics strong { color: #36465c; margin-left: 3px; font-weight: 600; }\r\n.download-current { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 13px; min-width: 0; }\r\n.download-current span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.download-current svg { flex-shrink: 0; }\r\n.download-report { display: flex; gap: 10px; padding: 13px; background: #fff9ef; color: #826134