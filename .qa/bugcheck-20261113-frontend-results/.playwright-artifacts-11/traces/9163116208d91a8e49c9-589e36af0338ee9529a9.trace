th: 100%; text-align: left; padding: 12px; gap: 5px; border: 1px solid transparent; background: transparent; color: inherit; border-radius: 8px; cursor: pointer; }\n.scene-directory-item.active { border-color: var(--primary); }\n.scene-directory-item code, .scene-directory-item small { overflow-wrap: anywhere; }\n.scene-details { container-type: inline-size; container-name: scene-details; min-width: 0; min-height: 0; padding: 16px; display: flex; flex-direction: column; overflow: hidden; }\n.scene-table-scroll { overflow-x: auto; }\n.scene-table { border-collapse: collapse; width: 100%; text-align: left; }\n.scene-table td, .scene-table th { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; overflow-wrap: anywhere; }\n.scene-actions { display: flex; flex-wrap: wrap; gap: 10px; }\n.scene-form { display: grid; gap: 16px; padding: 20px; }\n.scene-form fieldset { border: 0; padding: 0; display: grid; gap: 14px; }\n.scene-form label { display: grid; gap: 6px; }\n.scene-form label:has(input[type=checkbox]), .scene-form label:has(input[type=radio]) { display: flex; align-items: center; gap: 8px; }\n.scene-form input:not([type=checkbox]):not([type=radio]), .scene-form select, .scene-form textarea { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font: inherit; color: inherit; background: var(--surface); }\n.scene-form legend { padding: 0; margin-bottom: 4px; font-weight: 600; }\n/* The rule's category picker (category-picker) keeps its own field look inside the form */\n.scene-form .cp { margin-top: 0; }\n.scene-form .cp-label { color: inherit; font-size: inherit; line-height: inherit; }\n.scene-form .cp-combo input:not([type=checkbox]):not([type=radio]) { width: auto; padding: 0; border: 0; border-radius: 0; background: transparent; }\n.rule-kind { display: flex; flex-wrap: wrap; gap: 8px 20px; }\n.scene-membership-panel { margin-top: 20px; }\n.scene-membership-head { display: flex; flex-wrap: wrap; align-item