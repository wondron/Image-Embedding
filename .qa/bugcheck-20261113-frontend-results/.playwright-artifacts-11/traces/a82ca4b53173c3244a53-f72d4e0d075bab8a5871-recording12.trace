; }\n.scene-management .scene-details[data-sticky-heading=true] .scene-detail-tabs { position: sticky; top: var(--scene-heading-height, 0px); z-index: 1; }\n.scene-management .scene-details[data-sticky-heading=false] .scene-detail-tabs { position: sticky; top: 0; z-index: 1; }\n.scene-management .scene-tab-body { padding-top: 16px; min-width: 0; }\n.scene-management .scene-overview { display: grid; gap: 24px; }\n.scene-management .scene-overview-group { display: grid; gap: 8px; min-width: 0; }\n.scene-management .scene-overview-group h4, .scene-management .scene-tab-toolbar h4 { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.4; }\n.scene-management .scene-group-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }\n.scene-management .scene-description, .scene-management .scene-detail-caption { margin: 0; overflow-wrap: anywhere; }\n.scene-management .scene-detail-caption { font-size: 12px; line-height: 1.4; color: var(--muted); }\n.scene-management .scene-member-count { margin: 0; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.scene-management .scene-summary { display: grid; gap: 8px; margin: 0; }\n.scene-management .scene-summary > div { display: grid; grid-template-columns: minmax(0, max-content) minmax(0, 1fr); gap: 8px; align-items: start; min-width: 0; }\n.scene-management .scene-summary dt, .scene-management .scene-summary dd { margin: 0; overflow-wrap: anywhere; }\n.scene-management .scene-tab-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }\n.scene-management .scene-tab-empty { padding: 16px; }\n.scene-management .scene-table-actions { display: flex; flex-wrap: wrap; gap: 8px; }\n.scene-management .scene-detail-trace { display: block; margin-top: 16px; color: var(--muted); overflow-wrap: anywhere; }\n.scene-management .scene-sync-panel { display: grid; gap: 14px; min-width: 0; }\n.scene-managem