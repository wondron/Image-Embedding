# 后端本地调试用的环境变量模板。复制成同目录的 .env（已在 .gitignore 里，不会提交）再填值：
#   Copy-Item .env.example .env
# 后端 import app.core.config.settings 时自动读 backend/.env（API、Alembic、workers、scripts 都一样）；
# 已经设置的环境变量优先，不会被 .env 覆盖，所以临时切换可以直接 $env:NACOS_ENABLED='false'。
# docker compose 部署不用这个文件：变量直接写在 docker-compose*.yml 的 environment 里（镜像里也没有 .env）。
# 读哪些 dataId 不在这里，在 app/core/config/constant.py 的 NACOS_DATA_ID_LIST。
# prod / test 两套 namespace、账号、密码见 docker-compose.server.yml 的 x-nacos-prod / x-nacos-test。

# 环境标识 prod / test（不设按 prod）：日志、/version、/config_info 显示它，reset_data 在 prod 下拒绝执行。
# 它只是标识，真正连哪个环境由下面的 NACOS_NAMESPACE 和账号决定，切换时要成套修改。
NACOS_ENV=test

# 是否读 Nacos。false：只用本地 config/param/config.yaml，下面的 NACOS_* 都可以不填
NACOS_ENABLED=true

# NACOS_ENABLED=true 时必填
NACOS_SERVER_ADDR=http://nacos.myroki.com:8848
NACOS_NAMESPACE=adfc3ec2-a1ea-4b31-9b1a-fafb4228c8ca
NACOS_GROUP=ROKI_AI_GROUP

# Nacos 账号，没开鉴权时留空
NACOS_USERNAME=roki-ai-test
NACOS_PASSWORD=

# 以下可选，值为默认值
# 启动后是否定时重读 Nacos（predict 的模型配置热更新靠它）
# NACOS_POLL_ENABLED=true
# 重读间隔；重读失败后隔多久再试（秒）
# NACOS_POLL_INTERVAL_SECONDS=10
# NACOS_RETRY_INTERVAL_SECONDS=5
# 请求 Nacos 的连接超时、读取超时（秒）
# NACOS_CONNECT_TIMEOUT_SECONDS=2
# NACOS_REQUEST_TIMEOUT_SECONDS=3
