# Local host-side debug (IDE / uvicorn on Windows). Compose service DNS
# names (postgres, qdrant) only resolve inside the docker network.
APP_HOST=0.0.0.0

# Skip PG/Qdrant wiring when debugging FoodService/predict only:
# RETRIEVAL_ENABLED=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=image_emb
POSTGRES_PASSWORD=image_emb
POSTGRES_DATABASE=image_embedding
DATABASE_URL=postgresql+psycopg://image_emb:image_emb@localhost:5432/image_embedding

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# S3 mock by default — see app.core.config.settings
S3_USE_BOTO3=0
